<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- default dialog action button sizing when used inside dialogs -->
  <Style x:Key="DialogButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Shared card container used inside dialogs -->
  <Style x:Key="DialogCard" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="16" ShadowDepth="0" Direction="270"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Typography for dialogs -->
  <Style x:Key="DialogTitleText" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <Style x:Key="DialogCaptionText" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="DialogHintText" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundDimmed}" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
