<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
                    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI">

    <!-- Global layout radiuses (rounds buttons, checkboxes, inputs globally) -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="{x:Static adonisUi:Dimensions.CornerRadius}">6</CornerRadius>

    <!-- Global border thicknesses -->
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <Thickness x:Key="OverlayBorderThickness">1</Thickness>
    <Thickness x:Key="{x:Static adonisUi:Dimensions.BorderThickness}">1</Thickness>

    <!-- Override AdonisUI colors to match the website's premium deep pro-audio dark blue scheme -->
    
    <!-- Layer 0 Overrides (App Window Backdrop) -->
    <Color x:Key="{x:Static adonisUi:Colors.Layer0BackgroundColor}">#080B11</Color>
    <Color x:Key="{x:Static adonisUi:Colors.Layer0BorderColor}">#202D45</Color>

    <!-- Layer 1 Overrides (Buttons, ComboBoxes, Sidebar Panels) -->
    <Color x:Key="{x:Static adonisUi:Colors.Layer1BackgroundColor}">#0F1624</Color>
    <Color x:Key="{x:Static adonisUi:Colors.Layer1HighlightColor}">#162136</Color>
    <Color x:Key="{x:Static adonisUi:Colors.Layer1HighlightBorderColor}">#007880</Color>
    <Color x:Key="{x:Static adonisUi:Colors.Layer1InteractionColor}">#0B101B</Color>
    <Color x:Key="{x:Static adonisUi:Colors.Layer1InteractionBorderColor}">#005F66</Color>
    <Color x:Key="{x:Static adonisUi:Colors.Layer1BorderColor}">#202D45</Color>

    <!-- Layer 2 Overrides (Inner Cards, List Panel Areas) -->
    <Color x:Key="{x:Static adonisUi:Colors.Layer2BackgroundColor}">#161F30</Color>
    <Color x:Key="{x:Static adonisUi:Colors.Layer2HighlightColor}">#202D45</Color>
    <Color x:Key="{x:Static adonisUi:Colors.Layer2HighlightBorderColor}">#007880</Color>
    <Color x:Key="{x:Static adonisUi:Colors.Layer2InteractionColor}">#0F1624</Color>
    <Color x:Key="{x:Static adonisUi:Colors.Layer2InteractionBorderColor}">#005F66</Color>
    <Color x:Key="{x:Static adonisUi:Colors.Layer2BorderColor}">#2A3C5B</Color>

    <!-- Layer 3 Overrides (Input text fields, grooves, and tracks) -->
    <Color x:Key="{x:Static adonisUi:Colors.Layer3BackgroundColor}">#141416</Color>
    <Color x:Key="{x:Static adonisUi:Colors.Layer3HighlightColor}">#1C293E</Color>
    <Color x:Key="{x:Static adonisUi:Colors.Layer3HighlightBorderColor}">#007880</Color>
    <Color x:Key="{x:Static adonisUi:Colors.Layer3InteractionColor}">#0F1624</Color>
    <Color x:Key="{x:Static adonisUi:Colors.Layer3InteractionBorderColor}">#005F66</Color>
    <Color x:Key="{x:Static adonisUi:Colors.Layer3BorderColor}">#2A3C5B</Color>

    <!-- Override foreground/text colors for high contrast against dark blue background -->
    <Color x:Key="{x:Static adonisUi:Colors.ForegroundColor}">#F3F4F6</Color>

    <!-- Accent Overrides (Hardware Cyan-Teal branding) -->
    <Color x:Key="{x:Static adonisUi:Colors.AccentColor}">#007880</Color>
    <Color x:Key="{x:Static adonisUi:Colors.AccentHighlightColor}">#0096A0</Color>
    <Color x:Key="{x:Static adonisUi:Colors.AccentIntenseHighlightColor}">#00B3C0</Color>
    <Color x:Key="{x:Static adonisUi:Colors.AccentInteractionColor}">#005F66</Color>
    <Color x:Key="{x:Static adonisUi:Colors.AccentForegroundColor}">#FFFFFF</Color>
    <Color x:Key="{x:Static adonisUi:Colors.AccentInteractionForegroundColor}">#FFFFFF</Color>
    <Color x:Key="{x:Static adonisUi:Colors.AccentIntenseHighlightBorderColor}">#00B3C0</Color>

    <!-- Implicit Styles for List and Tab Items to follow the rounded channels layout -->
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="adonisExtensions:CornerRadiusExtension.CornerRadius" Value="4" />
        <Setter Property="Margin" Value="2,1" />
    </Style>

    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
        <Setter Property="adonisExtensions:CornerRadiusExtension.CornerRadius" Value="4,4,0,0" />
    </Style>

</ResourceDictionary>
