<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI">
    <!--
        App-wide default text color. Without this, any TextBlock/Label that doesn't explicitly
        set its own Foreground (or inherit one from a page that remembered to set its own root
        Foreground) falls back to WPF's raw default, which is opaque black — invisible/near-
        invisible against this app's dark theme. Merged LAST in App.xaml (after both AdonisUI
        dictionaries) so it wins over whatever, if anything, AdonisUI's own theme provides for
        these implicit styles, and stays theme-aware via AdonisUI's ForegroundBrush rather than
        hardcoding a color. Note the {x:Static} indirection — every AdonisUI brush is exposed as
        a ComponentResourceKey, not a plain string; "{DynamicResource AdonisUI.ForegroundBrush}"
        silently resolves to nothing (that key doesn't exist) rather than erroring, which is
        exactly how the black-text bug this file fixes went unnoticed for so long.
    -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="{x:Type Page}">
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="{x:Type UserControl}">
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!--
        Same underlying bug as the TextBlock/Label styles above, just harder to spot: nothing
        styles ToolTip itself, so it keeps WPF's default (light/system) background — but its
        content still ends up light text (either via the TextBlock style above catching an
        internal one, or a Label-hosted ToolTip somewhere), making it light-on-light and
        effectively invisible against this app's dark theme.
    -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HasDropShadow" Value="True"/>
    </Style>
</ResourceDictionary>
