<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:StreamFlow.App.Converter"
                    xmlns:controls="clr-namespace:StreamFlow.App.Controls"
                    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
                    xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI">
    <!--xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"-->
  <!-- Building blocks for the header progress slider -->
  <conv:SliderFillWidthConverter x:Key="SliderFillWidthConverter"/>
  <ControlTemplate x:Key="TrackFillTemplate" TargetType="RepeatButton">
    <Border Background="{StaticResource ProgressFillBrush}" CornerRadius="2" />
  </ControlTemplate>
  <ControlTemplate x:Key="TrackEmptyTemplate" TargetType="RepeatButton">
    <Border Background="Transparent" />
  </ControlTemplate>
  <ControlTemplate x:Key="HiddenThumbTemplate" TargetType="Thumb">
    <!-- Larger hit target for dragging while remaining visually minimal -->
    <Border Background="Transparent" Width="12" Height="20" Cursor="Hand" />
  </ControlTemplate>

  <!-- Header progress: slim amber bar without Fluent thumb chrome -->
  <Style x:Key="HeaderProgressSliderStyle" TargetType="Slider">
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid x:Name="Root" SnapsToDevicePixels="True" Cursor="Hand" MinHeight="16">
            <!-- Base track -->
            <Border x:Name="BaseTrack" Background="{StaticResource ProgressTrackBrush}"
                    Height="8" VerticalAlignment="Center" CornerRadius="3"
                    BorderThickness="1" BorderBrush="{StaticResource LineBrush}"/>
            <!-- Visible fill driven by value -->
            <Border x:Name="Fill"
                    Background="{StaticResource ProgressFillBrush}"
                    VerticalAlignment="Center" CornerRadius="3"
                    HorizontalAlignment="Left" Margin="0"
                    Height="{Binding ElementName=BaseTrack, Path=ActualHeight}"
                    IsHitTestVisible="False">
              <Border.Width>
                <MultiBinding Converter="{StaticResource SliderFillWidthConverter}">
                  <Binding ElementName="Root" Path="ActualWidth"/>
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Minimum"/>
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                </MultiBinding>
              </Border.Width>
            </Border>

            <!-- Position tick (visible on hover) -->
            <Border x:Name="PointerHost" HorizontalAlignment="Left" Background="Transparent" IsHitTestVisible="False">
              <Border.Width>
                <MultiBinding Converter="{StaticResource SliderFillWidthConverter}">
                  <Binding ElementName="Root" Path="ActualWidth"/>
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Minimum"/>
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                </MultiBinding>
              </Border.Width>
              <Border HorizontalAlignment="Right" Width="2" VerticalAlignment="Center" CornerRadius="1"
                      Height="{Binding ElementName=BaseTrack, Path=ActualHeight}"
                      Background="{StaticResource AccentDimBrush}" Opacity="0.9" Visibility="Collapsed" x:Name="PointerTick"/>
            </Border>

            <!-- Transparent track captures input/keyboard -->
            <Track x:Name="PART_Track" Height="16"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                   Focusable="False">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge"
                              Template="{StaticResource TrackEmptyTemplate}" Height="20" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge"
                              Template="{StaticResource TrackEmptyTemplate}" Height="20" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <!-- Minimal thumb ensures Track layout has a reference point while remaining invisible -->
                <Thumb Template="{StaticResource HiddenThumbTemplate}" />
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PART_Track" Property="Opacity" Value="0.6"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="PointerTick" Property="Visibility" Value="Visible"/>
              <Setter TargetName="BaseTrack" Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

<!-- Style targeting the horizontal Slider Track -->
<Style x:Key="RoundedSliderTrackStyle" TargetType="{x:Type RepeatButton}">
    <Setter Property="OverridesDefaultStyle" Value="true"/>
    <Setter Property="IsTabStop" Value="false"/>
    <Setter Property="Focusable" Value="false"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="{x:Type RepeatButton}">
                <!-- Use a Border to apply the CornerRadius -->
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Opacity="{TemplateBinding Opacity}"
                        adonisExtensions:CornerRadiusExtension.CornerRadius="5"
                        CornerRadius="5"/>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<!--
Playback scrubber — same visual language as the channel strip's stream-volume fader
(ChannelFaderStyle in AudioChannelStrip.xaml): a thin rounded groove with a solid pill thumb,
just horizontal instead of vertical and without that style's tick marks (a continuous seek
position, not a leveled control).
-->
<Style x:Key="DawScrubSliderStyle" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
    <Setter Property="Height" Value="20"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Slider">
                <Grid Background="{TemplateBinding Background}">
                    <!-- Visible groove the thumb rides along. -->
                    <Border Height="4" Margin="9,0,9,0" VerticalAlignment="Center" CornerRadius="2"
                            Background="{StaticResource ProgressTrackBrush}"
                            BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="1"/>
                    <Track x:Name="PART_Track" Height="18">
                        <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Template="{StaticResource TrackEmptyTemplate}" Focusable="False"/>
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Template="{StaticResource TrackEmptyTemplate}" Focusable="False"/>
                        </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="12" Height="18" Cursor="SizeWE">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Border CornerRadius="2" BorderThickness="1" BorderBrush="#1E1E20">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#B9B9BE" Offset="0"/>
                                                            <GradientStop Color="#8E8E93" Offset="0.45"/>
                                                            <GradientStop Color="#606065" Offset="0.55"/>
                                                            <GradientStop Color="#7C7C81" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <!-- Center grip line, the classic fader-cap position marker. -->
                                                <Rectangle Height="12" Width="2" Margin="3,3" VerticalAlignment="Center" Fill="#2A2A2E" RadiusX="1" RadiusY="1"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                </Grid>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

  <!-- Playback progress bar: slim fill bar with a thumb that blends into the fill
       rather than standing out as a separate handle (same brush, no border/shadow). -->
  <Style x:Key="PlaybackProgressSliderStyle" TargetType="Slider">
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid x:Name="Root" SnapsToDevicePixels="True" Cursor="Hand" MinHeight="20">
            <Border x:Name="BaseTrack" Background="{StaticResource ProgressTrackBrush}"
                    Height="6" VerticalAlignment="Center" CornerRadius="3"/>
            <Border x:Name="Fill"
                    Background="{StaticResource ProgressFillBrush}"
                    VerticalAlignment="Center" CornerRadius="3"
                    HorizontalAlignment="Left" Margin="0"
                    Height="{Binding ElementName=BaseTrack, Path=ActualHeight}"
                    IsHitTestVisible="False">
              <Border.Width>
                <MultiBinding Converter="{StaticResource SliderFillWidthConverter}">
                  <Binding ElementName="Root" Path="ActualWidth"/>
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Minimum"/>
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                </MultiBinding>
              </Border.Width>
            </Border>

            <Track x:Name="PART_Track" Height="20"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                   Focusable="False">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge"
                              Template="{StaticResource TrackEmptyTemplate}" Height="20" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge"
                              Template="{StaticResource TrackEmptyTemplate}" Height="20" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="PART_Thumb" Cursor="Hand">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse Width="15" Height="15" Fill="{StaticResource ProgressFillBrush}"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PART_Track" Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Time badge: framed pill with thin inner stroke -->
  <Style x:Key="TimeBadgeBorderStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ProgressTrackBrush}"/>
  </Style>

  <!-- Monospace time text -->
  <Style x:Key="MonoTimeText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Icon button with amber outline on hover/press. Hover/press states are separate overlay
       layers cross-faded via Opacity (animating a TemplateBinding'd property directly isn't
       reliable in WPF) with a press-scale bounce via BackEase — same technique as
       AudioChannelStrip's toggle buttons, applied here since this style backs most of the app's
       transport/icon buttons. -->
  <Style x:Key="HoverIconStyle" TargetType="Button">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="PressScale"/>
            </Grid.RenderTransform>
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"/>
            <Border x:Name="HoverOverlay" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource AccentDimBrush}" Opacity="0"/>
            <Border x:Name="PressOverlay" CornerRadius="3" BorderThickness="1" Background="{StaticResource OverlayHighBrush}" BorderBrush="{StaticResource AccentBrush}" Opacity="0"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/></Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
                    <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.90" Duration="0:0:0.08"/>
                    <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.90" Duration="0:0:0.08"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Large circular transport button (play/pause) — an outlined ring around the icon,
       filling faintly on hover/press. Distinct from HoverIconStyle (square, no ring) since
       this is meant to be the one visually "hero" control in a transport row. -->
  <!-- Same overlay-cross-fade + press-bounce technique as HoverIconStyle above, adapted to a
       ring instead of a bordered box: a hover/press Ellipse overlay fades in/out on top of the
       base ring rather than snapping its Fill/Stroke directly. -->
  <Style x:Key="CircleIconButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="PressScale"/>
            </Grid.RenderTransform>
            <Ellipse x:Name="Ring" Fill="{TemplateBinding Background}"
                     Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"/>
            <Ellipse x:Name="HoverRing" Fill="{StaticResource OverlayLowBrush}" Opacity="0"/>
            <Ellipse x:Name="PressRing" Fill="{StaticResource OverlayHighBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Opacity="0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/></Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
                    <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.08"/>
                    <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.08"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Ring" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <!-- ContentPresenter isn't part of the Ellipse-only template above, so icon content is
         layered by the caller (a Grid with the Button and a Path sibling) rather than here —
         see AudioControls.xaml's play/pause button for the pattern. -->
  </Style>

  <!-- Small transport toggle (repeat/shuffle) — same square hover chrome as HoverIconStyle,
       plus an accent tint while checked so the active state is visible at a glance. Hover fade
       + press bounce use the same overlay technique as HoverIconStyle; the checked-state icon
       tint is left as an instant Foreground swap — animating an inherited Foreground reliably
       needs a literal (non-DynamicResource) brush and a bigger restructure than a small icon
       tint justifies here. -->
  <Style x:Key="ToggleIconStyle" TargetType="ToggleButton">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="PressScale"/>
            </Grid.RenderTransform>
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"/>
            <Border x:Name="HoverOverlay" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource AccentDimBrush}" Opacity="0"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/></Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.90" Duration="0:0:0.08"/>
                    <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.90" Duration="0:0:0.08"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
