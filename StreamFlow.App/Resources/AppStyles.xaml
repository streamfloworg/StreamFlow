    <Style x:Key="IconOnlyPlayPauseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1.0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="AudioGridViewTemplate" DataType="{x:Type audio:Audio}">
        <Grid
            x:Name="GridViewItemGrid"
            Style="{StaticResource ItemFlyoutMenu}"
            Width="120"
            Height="145"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.InputBindings>
                <MouseBinding
                    MouseAction="LeftDoubleClick"
                    Command="{Binding ViewModel.PlayAudioItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                    CommandParameter="{Binding}"/>
            </Grid.InputBindings>

            <!-- Card Border -->
            <Border
                BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}"
                BorderThickness="1"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                CornerRadius="8"
                Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Album Art Image Container -->
                        <RowDefinition Height="100"/>
                        <!-- Text / Title -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Album Art Cover -->
                    <Border
                        Grid.Row="0"
                        CornerRadius="7,7,0,0"
                        ClipToBounds="True"
                        x:Name="ImageContainer"
                        Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}">
                        <Grid>
                            <Border x:Name="ImagePlaceholder">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill" ImageSource="{Binding ImageSource}" />

                                </Border.Background>
                                <Border.OpacityMask>
                                    <VisualBrush>
                                        <VisualBrush.Visual>
                                            <Rectangle Width="84" Height="84" Fill="White" RadiusX="6" RadiusY="6"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.OpacityMask>
                            </Border>

                            <!-- Centered Play/Pause Button overlay -->
                            <Button
                                x:Name="PlayPauseBtn"
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource IconOnlyPlayPauseButtonStyle}"
                                Visibility="Collapsed"
                                Command="{Binding ViewModel.PlayAudioItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                CommandParameter="{Binding}">
                                <Path
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform"
                                    Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                                    Height="22"
                                    Width="22">
                                    <Path.Data>
                                        <MultiBinding Converter="{StaticResource AudioStateToIconConverter}">
                                            <Binding Path="." />
                                            <Binding Path="ViewModel.AudioTrack" RelativeSource="{RelativeSource AncestorType={x:Type Page}}" />
                                        </MultiBinding>
                                    </Path.Data>
                                    <Path.BitmapEffect>
                                        <DropShadowBitmapEffect ShadowDepth="3" Softness="10" Opacity="0.4" Color="{DynamicResource {x:Static adonisUi:Colors.AccentColor}}"/>
                                    </Path.BitmapEffect>
                                </Path>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Title Text -->
                    <TextBlock
                        Grid.Row="1"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="6,4"
                        FontSize="11"/>
                </Grid>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <!-- Show audio type placeholder image -->
            <DataTrigger Binding="{Binding AudioType}" Value="SoundEffect">
                <Setter TargetName="ImagePlaceholder" Property="Background">
                    <Setter.Value>
                        <ImageBrush ImageSource="{Binding ImageSource, TargetNullValue={StaticResource DefaultSoundEffect}}" Stretch="UniformToFill" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding AudioType}" Value="AudioTrack">
                <Setter TargetName="ImagePlaceholder" Property="Background">
                    <Setter.Value>
                        <ImageBrush ImageSource="{Binding ImageSource, TargetNullValue={StaticResource DefaultAudioTrack}}" Stretch="UniformToFill" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>

            <!-- Hover trigger to show button -->
            <Trigger SourceName="GridViewItemGrid" Property="IsMouseOver" Value="True">
                <Setter TargetName="PlayPauseBtn" Property="Visibility" Value="Visible" />
            </Trigger>

            <!-- Always visible playing trigger for AudioTracks -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Value="True">
                        <Condition.Binding>
                            <MultiBinding Converter="{StaticResource AudioIsPlayingConverter}">
                                <Binding Path="." />
                                <Binding Path="ViewModel.AudioTrack" RelativeSource="{RelativeSource AncestorType={x:Type Page}}" />
                            </MultiBinding>
                        </Condition.Binding>
                    </Condition>
                    <Condition Binding="{Binding AudioType}" Value="AudioTrack" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PlayPauseBtn" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="AudioListViewTemplate" DataType="{x:Type audio:Audio}">
        <Grid
            x:Name="ListViewItemGrid"
            Height="64"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Style="{StaticResource ItemFlyoutMenu}">
            <Grid.ColumnDefinitions>
                <!-- Border category color strip -->
                <ColumnDefinition Width="Auto"/>
                <!-- Thumbnail / Album Art -->
                <ColumnDefinition Width="Auto"/>
                <!-- Text (Title / Details) -->
                <ColumnDefinition Width="*"/>
                <!-- Play button -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.InputBindings>
                <MouseBinding
                    MouseAction="LeftDoubleClick"
                    Command="{Binding ViewModel.PlayAudioItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                    CommandParameter="{Binding}"/>
            </Grid.InputBindings>

            <!-- Thumbnail/Art Container -->
            <Border
                Grid.Column="1"
                Width="48"
                Height="48"
                Margin="7,0,12,0"
                CornerRadius="6"
                x:Name="ImageContainer"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer2BorderBrush}}"
                BorderThickness="1"
                ClipToBounds="True">
                <Grid>
                    <Border x:Name="ImagePlaceholder">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill" ImageSource="{Binding ImageSource}" />
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <!-- Text Block details -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    TextTrimming="CharacterEllipsis"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                    FontSize="13"
                    Margin="0,0,0,2" />
                <TextBlock
                    x:Name="AudioSubText"
                    Text="Audio Track"
                    FontSize="11"
                    Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Hover Play/Pause button -->
            <Button
                x:Name="PlayPauseBtn"
                Grid.Column="3"
                Width="32"
                Height="32"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Style="{StaticResource IconOnlyPlayPauseButtonStyle}"
                Visibility="Collapsed"
                Command="{Binding ViewModel.PlayAudioItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                CommandParameter="{Binding}">
                <Path
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="Uniform"
                    Fill="{DynamicResource {x:Static adonisUi:Brushes.AccentBrush}}"
                    Height="16"
                    Width="16">
                    <Path.Data>
                        <MultiBinding Converter="{StaticResource AudioStateToIconConverter}">
                            <Binding Path="." />
                            <Binding Path="ViewModel.AudioTrack" RelativeSource="{RelativeSource AncestorType={x:Type Page}}" />
                        </MultiBinding>
                    </Path.Data>
                </Path>
            </Button>
        </Grid>
        <DataTemplate.Triggers>
            <!-- Show audio type in sub-text -->
            <DataTrigger Binding="{Binding AudioType}" Value="SoundEffect">
                <Setter TargetName="AudioSubText" Property="Text" Value="Sound Effect" />
                <Setter TargetName="ImagePlaceholder" Property="Background">
                    <Setter.Value>
                        <ImageBrush ImageSource="{Binding ImageSource, TargetNullValue={StaticResource DefaultSoundEffect}}" Stretch="UniformToFill" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding AudioType}" Value="AudioTrack">
                <Setter TargetName="AudioSubText" Property="Text" Value="Audio Track" />
                <Setter TargetName="ImagePlaceholder" Property="Background">
                    <Setter.Value>
                        <ImageBrush ImageSource="{Binding ImageSource, TargetNullValue={StaticResource DefaultAudioTrack}}" Stretch="UniformToFill" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>

            <!-- Hover trigger to show button -->
            <Trigger SourceName="ListViewItemGrid" Property="IsMouseOver" Value="True">
                <Setter TargetName="PlayPauseBtn" Property="Visibility" Value="Visible" />
            </Trigger>

            <!-- Always visible playing trigger for AudioTracks -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Value="True">
                        <Condition.Binding>
                            <MultiBinding Converter="{StaticResource AudioIsPlayingConverter}">
                                <Binding Path="." />
                                <Binding Path="ViewModel.AudioTrack" RelativeSource="{RelativeSource AncestorType={x:Type Page}}" />
                            </MultiBinding>
                        </Condition.Binding>
                    </Condition>
                    <Condition Binding="{Binding AudioType}" Value="AudioTrack" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PlayPauseBtn" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="AudioListViewItem" TargetType="ListViewItem">
        <Style.Resources>
            <Storyboard x:Key="FadeInAnimation">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Style.Resources>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
            </EventTrigger>
        </Style.Triggers>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Border HorizontalAlignment="Stretch" Name="_Border" CornerRadius="6" Margin="5,3">
                        <Grid Name="_Grid" Height="64">
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="_Border" Property="BorderThickness" Value="1" />
                            <Setter TargetName="_Grid" Property="Margin" Value="1" />
                            <Setter TargetName="_Border" Property="BorderBrush" Value="DodgerBlue"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="_Border" Property="BorderThickness" Value="1" />
                            <Setter TargetName="_Grid" Property="Margin" Value="1" />
                            <Setter TargetName="_Border" Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AudioGridViewItem" TargetType="ListViewItem">
        <Style.Resources>
            <Storyboard x:Key="FadeInAnimation">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Style.Resources>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
            </EventTrigger>
        </Style.Triggers>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Border HorizontalAlignment="Stretch" Name="_Border" CornerRadius="8" Margin="5">
                        <Grid Name="_Grid">
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="_Border" Property="BorderThickness" Value="1" />
                            <Setter TargetName="_Grid" Property="Margin" Value="1" />
                            <Setter TargetName="_Border" Property="BorderBrush" Value="DodgerBlue"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="_Border" Property="BorderThickness" Value="1" />
                            <Setter TargetName="_Grid" Property="Margin" Value="1" />
                            <Setter TargetName="_Border" Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AudioListView" TargetType="ListView">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <controls:FluidStackPanel DataContext="{Binding}"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate" Value="{StaticResource AudioListViewTemplate}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource AudioListViewItem}"/>
    </Style>

    <Style x:Key="AudioGridView" TargetType="ListView">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <controls:FluidWrapPanel DataContext="{Binding}"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate" Value="{StaticResource AudioGridViewTemplate}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource AudioGridViewItem}"/>
    </Style>

    <!-- Icon that brightens on hover -->
    <Style x:Key="HoverLightIcon" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="DimGray" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Fill" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--#endregion-->

    <!--#region Data Templates -->
    <!-- ListView: base style that shows a placeholder when empty -->
    <DataTemplate x:Key="Testing">

    </DataTemplate>

    <!--#endregion-->

</ResourceDictionary>
