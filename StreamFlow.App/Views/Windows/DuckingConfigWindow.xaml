<Window x:Class="StreamFlow.App.Views.Windows.DuckingConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
        Title="Side-Chain Ducking Configuration"
        Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
        Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}">
    <Window.Resources>
        <!-- Inactive segment button -->
        <Style x:Key="SegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static adonisUi:Brushes.Layer3BackgroundBrush}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active segment button — accent fill, white text -->
        <Style x:Key="SegmentButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource {x:Static adonisUi:Brushes.AccentBrush}}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border Padding="20">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Preset Segmented Button Group -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Presets" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                       Opacity="0.55" Margin="0,0,0,8"/>
            <Border Background="{DynamicResource {x:Static adonisUi:Brushes.Layer0BackgroundBrush}}"
                    BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}"
                    BorderThickness="1" CornerRadius="6" Height="34" Padding="2">
                <UniformGrid Columns="4">
                    <Button x:Name="PresetLight"      Content="Light"      Tag="light"      Style="{StaticResource SegmentButtonStyle}" Click="OnPresetClick"/>
                    <Button x:Name="PresetMedium"     Content="Medium"     Tag="medium"     Style="{StaticResource SegmentButtonActiveStyle}" Click="OnPresetClick"/>
                    <Button x:Name="PresetAggressive" Content="Aggressive" Tag="aggressive" Style="{StaticResource SegmentButtonStyle}" Click="OnPresetClick"/>
                    <Button x:Name="PresetCustom"     Content="Custom"     Tag="custom"     Style="{StaticResource SegmentButtonStyle}" Click="OnPresetClick"/>
                </UniformGrid>
            </Border>
        </StackPanel>

        <!-- Sliders -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top">
            <!-- Threshold -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Threshold" VerticalAlignment="Center" FontSize="12"/>
                <Slider x:Name="ThresholdSlider" Grid.Column="1" Minimum="-60" Maximum="0" Value="{Binding DuckingThresholdDb, Mode=TwoWay}" VerticalAlignment="Center" ValueChanged="OnSliderValueChanged"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=ThresholdSlider, StringFormat={}{0:F0} dB}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Depth -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Duck Depth" VerticalAlignment="Center" FontSize="12"/>
                <Slider x:Name="DepthSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding DuckingDepth, Mode=TwoWay}" VerticalAlignment="Center" ValueChanged="OnSliderValueChanged"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=DepthSlider, StringFormat={}{0:P0}}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Attack -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Attack" VerticalAlignment="Center" FontSize="12"/>
                <Slider x:Name="AttackSlider" Grid.Column="1" Minimum="1" Maximum="100" Value="{Binding DuckingAttackMs, Mode=TwoWay}" VerticalAlignment="Center" ValueChanged="OnSliderValueChanged"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=AttackSlider, StringFormat={}{0:F0} ms}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Release -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Release" VerticalAlignment="Center" FontSize="12"/>
                <Slider x:Name="ReleaseSlider" Grid.Column="1" Minimum="10" Maximum="1000" Value="{Binding DuckingReleaseMs, Mode=TwoWay}" VerticalAlignment="Center" ValueChanged="OnSliderValueChanged"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=ReleaseSlider, StringFormat={}{0:F0} ms}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Hold -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Hold" VerticalAlignment="Center" FontSize="12"/>
                <Slider x:Name="HoldSlider" Grid.Column="1" Minimum="0" Maximum="500" Value="{Binding DuckingHoldMs, Mode=TwoWay}" VerticalAlignment="Center" ValueChanged="OnSliderValueChanged"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=HoldSlider, StringFormat={}{0:F0} ms}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <Button Grid.Row="3" Content="Done" HorizontalAlignment="Right" Width="90" Height="32" Click="OnDoneClick" IsDefault="True"/>
    </Grid>
    </Border>
</Window>
