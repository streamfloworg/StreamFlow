<Page
    x:Name="appSettings"
    x:Class="StreamFlow.App.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:converters="clr-namespace:StreamFlow.App.Converter"
    xmlns:local="clr-namespace:StreamFlow.App.Views.Pages"
    xmlns:ah="clr-namespace:StreamFlow.Core.AudioHandling;assembly=StreamFlow.Core"
    xmlns:options="clr-namespace:StreamFlow.Core.Data.UserOptions;assembly=StreamFlow.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sf="clr-namespace:SoundFlow.Structs;assembly=SoundFlow"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:controls="clr-namespace:StreamFlow.App.Controls"
    Title="SettingsPage"
    d:DesignHeight="850"
    d:DesignWidth="800"
    ScrollViewer.CanContentScroll="False"
    d:DataContext="{d:DesignInstance local:SettingsPage, IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:DebugDummyConverter x:Key="DebugDummyConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!--  Spacing between cards  -->
        <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
        <!--  Style (inc. the correct spacing) of a section header  -->
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>
    <Grid Margin="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <ScrollViewer
            x:Name="RootScroll"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            CanContentScroll="True"
            PanningMode="VerticalOnly"
            Background="Transparent">
            <StackPanel
                MaxWidth="1220"
                Grid.IsSharedSizeScope="True">
                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Configuration" />
                
                <!-- Audio Output Device Card -->
                <Border Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}" BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,16,0" VerticalAlignment="Center" Data="{StaticResource SpeakerIconData}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Audio Output Device" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  Width="240"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding ViewModel.AudioOutputs.SourceCollection, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Name"
                                  SelectedValue="{Binding ViewModel.Settings.OutputDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Name"
                                  SelectionChanged="OutputDevice_SelectionChanged" />
                    </Grid>
                </Border>

                <!-- Theme Card -->
                <Border Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}" BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,16,0" VerticalAlignment="Center" Data="{StaticResource SettingsIconData}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
                        </StackPanel>
                        <ComboBox x:Name="cbThemeSelection"
                                  Grid.Column="2"
                                  Width="240"
                                  VerticalAlignment="Center"
                                  SelectionChanged="CbThemeSelection_SelectionChanged"
                                  SelectedValue="{Binding ViewModel.Settings.PreferredTheme, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Tag="Default">Use system setting</ComboBoxItem>
                            <ComboBoxItem Tag="Light">Light</ComboBoxItem>
                            <ComboBoxItem Tag="Dark">Dark</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Stream Deck Server Card -->
                <Border Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}" BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,0,0,4">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,16,0" VerticalAlignment="Center" Data="{StaticResource SettingsIconData}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Stream Deck Server" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
                                <TextBlock Text="Lets the StreamFlow Stream Deck plugin control streaming, scenes, and audio" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" Content="Enabled" VerticalAlignment="Center"
                                      IsChecked="{Binding ViewModel.IsStreamDeckServerEnabled, Mode=TwoWay}"/>
                        </Grid>
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding ViewModel.IsStreamDeckServerEnabled, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Port" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
                                <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                         Text="{Binding ViewModel.StreamDeckServerPort, Mode=TwoWay}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="API Key" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
                                <TextBox Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center"
                                         Text="{Binding ViewModel.StreamDeckApiKey, Mode=OneWay}"/>
                                <Button Grid.Column="2" Content="Copy" Padding="8,4" Margin="6,0,0,0"
                                        Command="{Binding ViewModel.CopyStreamDeckApiKeyCommand}"/>
                                <Button Grid.Column="3" Content="Regenerate" Padding="8,4" Margin="6,0,0,0"
                                        Command="{Binding ViewModel.RegenerateStreamDeckApiKeyCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding ViewModel.StreamDeckServerStatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Cache Settings Expander -->
                <Expander Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}" BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="1" Padding="0" Margin="0,0,0,4" IsExpanded="False">
                    <Expander.Header>
                        <Grid Margin="4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,16,0" VerticalAlignment="Center" Data="{StaticResource DeleteForeverIconData}" />
                            <TextBlock Grid.Column="1" Text="Cache" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="16,8,16,8">
                        <!-- Image Cache Sub-card -->
                        <Border Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}" BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer2BorderBrush}}" BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,16,0" VerticalAlignment="Center" Data="{StaticResource LevelMeterIconData}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Image Cache" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
                                </StackPanel>
                                <Menu Grid.Column="2" x:Name="AudioMenu" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                    <MenuItem AutomationProperties.Name="Unused Menu" x:Name="AudioMenuItem" FocusVisualStyle="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}">
                                        <MenuItem.Header>
                                            <Path Data="{StaticResource SettingsIconData}" Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource TextPrimaryBrush}" />
                                        </MenuItem.Header>
                                        <MenuItem x:Name="vc1" Header="Image Cache Folder" Command="{Binding ViewModel.OpenImageCacheFolderCommand}"/>
                                        <MenuItem x:Name="vc2" Header="Clear Image Cache" Command="{Binding ViewModel.ClearImageCacheCommand}"/>
                                    </MenuItem>
                                </Menu>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Expander>

                <!-- About Card -->
                <Border Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}" BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,16,0" VerticalAlignment="Center" Data="{StaticResource GoLiveIconData}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="About StreamFlow" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
                            <TextBlock Text="StreamFlow is a modern sound board app" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            <!-- Update UI only shows for the unpackaged/Velopack build — the
                                 MSIX build manages its own updates (see UpdateService). -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                        Visibility="{Binding ViewModel.ShowUpdateCheck, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="Check for Updates" Padding="8,3" FontSize="11" Command="{Binding ViewModel.CheckForUpdatesCommand}"/>
                                <Button Content="Install &amp; Restart" Padding="8,3" FontSize="11" Margin="6,0,0,0"
                                        Command="{Binding ViewModel.InstallUpdateCommand}"/>
                                <TextBlock Text="{Binding ViewModel.UpdateStatusText}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding ViewModel.AppVersion}" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
