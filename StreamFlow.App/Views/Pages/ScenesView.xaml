<Page
    x:Class="StreamFlow.App.Views.Pages.ScenesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:StreamFlow.App.Views.Pages"
    xmlns:vm="clr-namespace:StreamFlow.App.ViewModels.Pages"
    xmlns:conv="clr-namespace:StreamFlow.App.Converter"
    xmlns:services="clr-namespace:StreamFlow.App.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="clr-namespace:StreamFlow.Core.Data;assembly=StreamFlow.Core"
    xmlns:behaviors="clr-namespace:StreamFlow.App.Helpers.Behaviors"
    xmlns:controls="clr-namespace:StreamFlow.App.Controls"
    Title="ScenesPage"
    d:DataContext="{d:DesignInstance local:ScenesView, IsDesignTimeCreatable=False}"
    d:DesignHeight="650"
    d:Design.Background="{DynamicResource {x:Static adonisUi:Brushes.Layer0BackgroundBrush}}"
    d:Design.Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
    Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
    Loaded="ScenesView_Loaded"
    Unloaded="ScenesView_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:PercentToPixelConverter x:Key="PercentToPixel"/>
        <conv:PercentToDynamicPixelConverter x:Key="PercentToDynamicPixel"/>
        <conv:SlotRoleBrushConverter x:Key="SlotRoleBrush"/>
        <conv:AspectRatioTextConverter x:Key="AspectRatioText"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BoolToFontWeightConverter x:Key="BoolToFontWeight"/>
        <conv:BoolToFontStyleConverter x:Key="BoolToFontStyle"/>
        <conv:TextHorizontalAlignmentToIndexConverter x:Key="TextAlignmentToIndex"/>
        <conv:TextHorizontalAlignmentToTextAlignmentConverter x:Key="TextAlignmentToWpf"/>
        <conv:HotkeyConverter x:Key="HotkeyConverter"/>
        <conv:DoubleScaleConverter x:Key="DoubleScale"/>
        <conv:FontSizeToMessageSpacingMarginConverter x:Key="MessageSpacingMargin"/>
        <conv:NullVisibilityConverter x:Key="NullToVisibility"/>
        <conv:InvertedNullVisibilityConverter x:Key="InvertedNullToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:CornerClipConverter x:Key="CornerClip"/>
        <conv:ColorToBrushConverter x:Key="ColorToBrush"/>
        <conv:PercentToFractionConverter x:Key="PercentToFraction"/>
        <conv:RotationDegreesToIndexConverter x:Key="RotationDegreesToIndex"/>
        <conv:TimerModeToIndexConverter x:Key="TimerModeToIndex"/>
        <conv:TimerModeToVisibilityConverter x:Key="CountDownToVisibility"/>
        <conv:SceneTransitionKindToIndexConverter x:Key="SceneTransitionKindToIndex"/>
        <conv:CollectionCountToVisibilityConverter x:Key="CollectionCountToVisibility"/>



        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4FC3F7"/>
        <Style x:Key="RowSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Height" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="PanelSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: only shown once a Scene Set is loaded for editing on this page. -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,8" CornerRadius="6"
                BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="1"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                Visibility="{Binding ViewModel.IsSceneSetLoaded, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" MinWidth="160">
                    <TextBlock Text="Scene Set Name" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                    <TextBox Text="{Binding ViewModel.SceneEditor.SceneSetName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" MinWidth="160">
                    <TextBlock Text="Author" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                    <TextBox Text="{Binding ViewModel.SceneEditor.SceneSetAuthor, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <!-- Session-wide, not per-scene: how switching ActiveScene animates in the actual
                     composited/streamed output (see SceneEditorViewModel.ActivateSceneAsync). -->
                <StackPanel Grid.Column="3" MinWidth="220" Margin="16,0,0,0" HorizontalAlignment="Left">
                    <TextBlock Text="Scene Transition" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" SelectedIndex="{Binding ViewModel.SceneEditor.TransitionKind, Converter={StaticResource SceneTransitionKindToIndex}}">
                            <ComboBoxItem Content="Cut"/>
                            <ComboBoxItem Content="Fade"/>
                            <ComboBoxItem Content="Slide Left"/>
                            <ComboBoxItem Content="Slide Right"/>
                            <ComboBoxItem Content="Slide Up"/>
                            <ComboBoxItem Content="Slide Down"/>
                        </ComboBox>
                        <TextBox Grid.Column="2" Text="{Binding ViewModel.SceneEditor.TransitionDurationMs, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="3" Text="ms" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="💾 Save" Padding="10,4" Margin="0,0,8,0"
                            ToolTip="Overwrite the loaded Scene Set's own files"
                            Command="{Binding ViewModel.SceneEditor.SaveActiveSceneSetCommand}"/>
                    <Button Content="Save to disk (.sfset)…" Padding="10,4" Margin="0,0,8,0"
                            ToolTip="Export the current layout to a .sfset file you choose"
                            Command="{Binding ViewModel.SaveSceneSetToDiskCommand}"/>
                </StackPanel>
                <Button Grid.Column="5" Content="Close" Padding="10,4" VerticalAlignment="Bottom"
                        ToolTip="Close this page's editor — Go Live's own state is unaffected"
                        Command="{Binding ViewModel.CloseSceneSetCommand}"/>
            </Grid>
        </Border>

        <!-- Blank-state prompt: shown until the user explicitly loads a Scene Set here — even
             though SceneEditor's Scenes/ActiveScene may already be populated (Go Live loads them
             eagerly at app startup), this page never shows/edits them without an explicit
             opt-in. -->
        <Border Grid.Row="1" Visibility="{Binding ViewModel.IsSceneSetLoaded, Converter={StaticResource InverseBoolToVisibility}}"
                CornerRadius="6" BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="1"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <TextBlock Text="No Scene Set loaded" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Load one to start positioning layers — edits here show up live on the Go Live page too."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,0,0,16"/>

                <!-- Library browser: every Scene Set already imported (see SceneEditorViewModel.
                     RegisteredSceneSets) — absent entirely when empty rather than showing a
                     placeholder, since "Load from disk"/"Create New" below already cover getting
                     started from nothing. -->
                <StackPanel Visibility="{Binding ViewModel.SceneEditor.RegisteredSceneSets, Converter={StaticResource CollectionCountToVisibility}}"
                            Margin="0,0,0,16">
                    <TextBlock Text="My Scene Sets" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                    <Border BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ViewModel.SceneEditor.RegisteredSceneSets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Author, Converter={StaticResource NullToVisibility}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Load" Padding="10,4" Margin="0,0,4,0"
                                                        Command="{Binding RelativeSource={RelativeSource AncestorType=local:ScenesView}, Path=ViewModel.LoadRegisteredSceneSetCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="📤" ToolTip="Export to .sfset" Padding="8,4" Margin="0,0,4,0"
                                                        Command="{Binding RelativeSource={RelativeSource AncestorType=local:ScenesView}, Path=ViewModel.ExportRegisteredSceneSetCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="✕" ToolTip="Delete" Padding="8,4"
                                                        Command="{Binding RelativeSource={RelativeSource AncestorType=local:ScenesView}, Path=ViewModel.DeleteRegisteredSceneSetCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <Button Content="Load Go Live's Active Scene Set" Padding="0,8" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                        Command="{Binding ViewModel.LoadActiveSceneSetCommand}"
                        Visibility="{Binding ViewModel.SceneEditor.ActiveSceneSet, Converter={StaticResource NullToVisibility}}"/>

                <Separator Margin="0,0,0,12" Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}"/>

                <Button Content="Load Scene Set from disk (.sfset)…" Padding="0,8" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                        Command="{Binding ViewModel.LoadSceneSetFromDiskCommand}"/>
                <Button Content="Create New Scene Set" Padding="0,8" HorizontalAlignment="Stretch"
                        Command="{Binding ViewModel.CreateNewSceneSetCommand}"/>
            </StackPanel>
        </Border>

        <!-- Editor: the existing 3-column layout, shown once a Scene Set is loaded. -->
        <Grid Grid.Row="1" Visibility="{Binding ViewModel.IsSceneSetLoaded, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left column: scene picker/setup, layers list, selected-slot properties.
             No "Save Layout" button/HasUnsavedChanges anywhere here — persisting to disk stays
             a Go-Live-only action, see SceneEditorViewModel's own doc comment. -->
        <Border Grid.Column="0" CornerRadius="6" Padding="0" BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}"
                BorderThickness="1" Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Scenes" Style="{StaticResource FieldLabelStyle}"/>
                    <!-- Each scene is its own tab — selecting one drives ActiveScene exactly like
                         the old picker did. Content is deliberately blank (empty ContentTemplate):
                         the actual editor below (Layers/properties/canvas) already reacts to
                         ActiveScene on its own, so the tab strip only needs to act as a selector,
                         not host per-scene content itself. -->
                    <TabControl ItemsSource="{Binding ViewModel.SceneEditor.Scenes}"
                                SelectedItem="{Binding ViewModel.SceneEditor.ActiveScene, Mode=TwoWay}"
                                Padding="0" Margin="0,0,0,6">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Padding="2,0" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate/>
                        </TabControl.ContentTemplate>
                    </TabControl>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="+ Add" Padding="10,4" Margin="0,0,6,0"
                                ToolTip="Add scene" Command="{Binding ViewModel.SceneEditor.AddSceneCommand}"/>
                        <Button Content="📑 Duplicate" Padding="8,4" Margin="0,0,6,0"
                                ToolTip="Duplicate active scene" Command="{Binding ViewModel.SceneEditor.DuplicateActiveSceneCommand}"/>
                        <Button Content="✕ Remove" Padding="10,4" Margin="0,0,6,0"
                                ToolTip="Remove active scene" Command="{Binding ViewModel.SceneEditor.RemoveActiveSceneCommand}"/>
                        <Button Content="★ Default" Padding="8,4"
                                ToolTip="Set as default on launch"
                                Command="{Binding ViewModel.SceneEditor.SetActiveSceneAsDefaultCommand}"/>
                    </StackPanel>

                    <TextBlock Text="Scene Name" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding ViewModel.SceneEditor.ActiveScene.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Text="Switch Hotkey" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Height="24" Padding="6,2" Margin="0,0,0,8"
                             IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
                             PreviewKeyDown="SceneHotkeyTextBoxPreviewKeyDown"
                             Text="{Binding ViewModel.SceneEditor.ActiveScene.SwitchHotkey, Converter={StaticResource HotkeyConverter}, Mode=OneWay, TargetNullValue='Click to set...'}"/>

                    <!-- Canvas Resolution & Aspect Ratio controls (always available so user can set/lock scene dimensions) -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Canvas Resolution &amp; Aspect Ratio" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Text="No capture source set in this scene. Set a resolution/aspect ratio to render overlays at."
                                   Visibility="{Binding ViewModel.SceneEditor.HasNoCaptureSourcesInActiveScene, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>

                        <!-- Current Resolution & Aspect Ratio badge -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                            <TextBlock Text="Current: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding ViewModel.SceneEditor.ActiveScene.CanvasResolutionWidth, TargetNullValue=1920}" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Text="×" Margin="2,0,2,0" FontSize="11"/>
                            <TextBlock Text="{Binding ViewModel.SceneEditor.ActiveScene.CanvasResolutionHeight, TargetNullValue=1080}" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Text=" (" Margin="4,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding ViewModel.SceneEditor.ActiveSceneAspectRatioText}" Foreground="{DynamicResource {x:Static adonisUi:Brushes.AccentBrush}}" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Text=")" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>

                        <!-- Resolution Preset Dropdown -->
                        <ComboBox ItemsSource="{Binding ViewModel.SceneEditor.AvailableCanvasResolutions}"
                                  SelectedItem="{Binding ViewModel.SceneEditor.SelectedCanvasResolution}"
                                  DisplayMemberPath="DisplayName" Margin="0,0,0,6"/>

                        <!-- Aspect Ratio Presets Quick Bar -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="16:9" Margin="0,0,2,0" Padding="0,2" FontSize="10"
                                    ToolTip="16:9 Landscape (1920×1080)"
                                    Command="{Binding ViewModel.SceneEditor.SetAspectRatioPresetCommand}" CommandParameter="16:9"/>
                            <Button Grid.Column="1" Content="9:16" Margin="2,0,2,0" Padding="0,2" FontSize="10"
                                    ToolTip="9:16 Vertical (1080×1920)"
                                    Command="{Binding ViewModel.SceneEditor.SetAspectRatioPresetCommand}" CommandParameter="9:16"/>
                            <Button Grid.Column="2" Content="21:9" Margin="2,0,2,0" Padding="0,2" FontSize="10"
                                    ToolTip="21:9 Ultrawide (2560×1080)"
                                    Command="{Binding ViewModel.SceneEditor.SetAspectRatioPresetCommand}" CommandParameter="21:9"/>
                            <Button Grid.Column="3" Content="4:3" Margin="2,0,2,0" Padding="0,2" FontSize="10"
                                    ToolTip="4:3 Standard (1440×1080)"
                                    Command="{Binding ViewModel.SceneEditor.SetAspectRatioPresetCommand}" CommandParameter="4:3"/>
                            <Button Grid.Column="4" Content="1:1" Margin="2,0,0,0" Padding="0,2" FontSize="10"
                                    ToolTip="1:1 Square (1080×1080)"
                                    Command="{Binding ViewModel.SceneEditor.SetAspectRatioPresetCommand}" CommandParameter="1:1"/>
                        </Grid>

                        <!-- Manual Custom Width x Height Input -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ViewModel.SceneEditor.ManualCanvasWidth, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" Text="{Binding ViewModel.SceneEditor.ManualCanvasHeight, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="3" Content="Set" Margin="6,0,0,0" Padding="8,4"
                                    Command="{Binding ViewModel.SceneEditor.ApplyManualCanvasResolutionCommand}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CanvasResolutionDeviceCombo" Grid.Column="0"
                                      ItemsSource="{Binding ViewModel.SceneEditor.AvailableSources}"
                                      DisplayMemberPath="Name"
                                      adonisExtensions:WatermarkExtension.Watermark="Or match a device…"/>
                            <Button Grid.Column="1" Content="Use" Margin="6,0,0,0" Padding="8,4"
                                    Command="{Binding ViewModel.SceneEditor.SetCanvasResolutionFromDeviceCommand}"
                                    CommandParameter="{Binding ElementName=CanvasResolutionDeviceCombo, Path=SelectedItem}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Layers List (unifies captures and overlays) -->
                <Grid Grid.Row="1" MinHeight="120">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Layers" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+ Add Layer" Padding="10,3" FontSize="11" Click="AddLayer_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="AddLayerMenu" DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Capture Source" Command="{Binding ViewModel.SceneEditor.AddCaptureSourceCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Image Overlay" Command="{Binding ViewModel.SceneEditor.AddImageOverlayCommand}"/>
                                    <MenuItem Header="Text Overlay" Command="{Binding ViewModel.SceneEditor.AddTextOverlayCommand}"/>
                                    <MenuItem Header="Color Overlay" Command="{Binding ViewModel.SceneEditor.AddColorOverlayCommand}"/>
                                    <MenuItem Header="Video Overlay" Command="{Binding ViewModel.SceneEditor.AddVideoOverlayCommand}"/>
                                    <MenuItem Header="Chat Overlay" Command="{Binding ViewModel.SceneEditor.AddChatOverlayCommand}"/>
                                    <MenuItem Header="Timer Overlay" Command="{Binding ViewModel.SceneEditor.AddTimerOverlayCommand}"/>
                            <MenuItem Header="Blur Layer" Command="{Binding ViewModel.SceneEditor.AddBlurOverlayCommand}"/>
                                    <MenuItem Header="Overlay Group" Command="{Binding ViewModel.SceneEditor.AddGroupOverlayCommand}"/>
                                    <MenuItem Header="Stream Alert" Command="{Binding ViewModel.SceneEditor.AddAlertOverlayCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" CornerRadius="4" BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer2BorderBrush}}" BorderThickness="1" Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}">
                        <TreeView ItemsSource="{Binding ViewModel.SceneEditor.Slots}"
                                  SelectedItemChanged="TreeView_SelectedItemChanged"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="New Group" Click="NewGroupFromSelected_Click"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Setter Property="IsExpanded" Value="True"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="behaviors:SlotReorderBehavior.IsDropTarget" Value="True"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource {x:Static adonisUi:Brushes.AccentBrush}}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:SourceSlot}" ItemsSource="{Binding Children}">
                                    <Grid Tag="{Binding RelativeSource={RelativeSource AncestorType=TreeView}, Path=DataContext}">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                 <MenuItem Header="Add to Group"
                                                           ItemsSource="{Binding PlacementTarget.Tag.ViewModel.SceneEditor.ExistingGroupSlots, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                           Visibility="{Binding CanBeAddedToGroup, Converter={StaticResource BoolToVisibility}}">
                                                     <MenuItem.ItemContainerStyle>
                                                         <Style TargetType="MenuItem">
                                                             <Setter Property="Header" Value="{Binding DisplayName}"/>
                                                             <Setter Property="Command" Value="{Binding PlacementTarget.Tag.ViewModel.SceneEditor.AddSelectedSlotToGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                             <Setter Property="CommandParameter" Value="{Binding}"/>
                                                         </Style>
                                                     </MenuItem.ItemContainerStyle>
                                                 </MenuItem>
                                                 <MenuItem Header="Remove from Group"
                                                           Command="{Binding PlacementTarget.Tag.ViewModel.SceneEditor.RemoveSelectedSlotFromGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                           Visibility="{Binding ParentGroup, Converter={StaticResource NullToVisibility}}"/>
                                                 <MenuItem Header="New Group" Click="NewGroupFromSelected_Click"/>
                                                 <MenuItem Header="Delete"
                                                           Command="{Binding PlacementTarget.Tag.ViewModel.SceneEditor.RemoveSlotCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                           CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="⠿" FontFamily="Segoe UI Symbol" FontSize="14"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Cursor="SizeAll"/>
                                        <Path x:Name="TypeIcon" Grid.Column="1" Margin="0,0,8,0" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold"/>

                                        <!-- Hover Delete Button -->
                                        <Button Grid.Column="3" Content="✕" Padding="6,2" FontSize="10"
                                                Background="#44ff0000" Foreground="White" BorderThickness="0"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=local:ScenesView}, Path=ViewModel.SceneEditor.RemoveSlotCommand}"
                                                CommandParameter="{Binding}"
                                                x:Name="RowDeleteButton" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                    <HierarchicalDataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsMouseOver}" Value="True">
                                            <Setter TargetName="RowDeleteButton" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                            <Setter TargetName="TypeIcon" Property="Data" Value="{StaticResource MonitorIconData}"/>
                                            <Setter TargetName="TypeIcon" Property="Fill" Value="#06B6D4"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPrimary}" Value="False"/>
                                                <Condition Binding="{Binding IsOverlay}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="TypeIcon" Property="Data" Value="{StaticResource CameraIconData}"/>
                                            <Setter TargetName="TypeIcon" Property="Fill" Value="#10B981"/>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding OverlayKind}" Value="Image">
                                            <Setter TargetName="TypeIcon" Property="Data" Value="{StaticResource ImageIconData}"/>
                                            <Setter TargetName="TypeIcon" Property="Fill" Value="#D946EF"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverlayKind}" Value="Text">
                                            <Setter TargetName="TypeIcon" Property="Data" Value="{StaticResource TextIconData}"/>
                                            <Setter TargetName="TypeIcon" Property="Fill" Value="#F59E0B"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverlayKind}" Value="Color">
                                            <Setter TargetName="TypeIcon" Property="Data" Value="{StaticResource PaletteIconData}"/>
                                            <Setter TargetName="TypeIcon" Property="Fill" Value="#EF4444"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverlayKind}" Value="Video">
                                            <Setter TargetName="TypeIcon" Property="Data" Value="{StaticResource VideoOverlayIconData}"/>
                                            <Setter TargetName="TypeIcon" Property="Fill" Value="#6366F1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverlayKind}" Value="Chat">
                                            <Setter TargetName="TypeIcon" Property="Data" Value="{StaticResource ChatIconData}"/>
                                            <Setter TargetName="TypeIcon" Property="Fill" Value="#14B8A6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverlayKind}" Value="Timer">
                                            <Setter TargetName="TypeIcon" Property="Data" Value="{StaticResource TimerIconData}"/>
                                            <Setter TargetName="TypeIcon" Property="Fill" Value="#F59E0B"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverlayKind}" Value="Blur">
                                            <Setter TargetName="TypeIcon" Property="Data" Value="{StaticResource BlurIconData}"/>
                                            <Setter TargetName="TypeIcon" Property="Fill" Value="#94A3B8"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverlayKind}" Value="Group">
                                            <Setter TargetName="TypeIcon" Property="Data" Value="{StaticResource GroupIconData}"/>
                                            <Setter TargetName="TypeIcon" Property="Fill" Value="#EC4899"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverlayKind}" Value="Alert">
                                            <Setter TargetName="TypeIcon" Property="Data" Value="{StaticResource BellIconData}"/>
                                            <Setter TargetName="TypeIcon" Property="Fill" Value="#EF4444"/>
                                        </DataTrigger>
                                    </HierarchicalDataTemplate.Triggers>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="2" Style="{StaticResource RowSplitterStyle}"/>

                <!-- Layer Properties -->
                <Border Grid.Row="3" BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="0,1,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,12,0,0" DataContext="{Binding ViewModel.SceneEditor.SelectedSlot}">
                            <controls:SectionPanel HeaderText="Layer Properties">
                                <controls:SectionPanel.Style>
                                    <Style TargetType="{x:Type controls:SectionPanel}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:SectionPanel.Style>
                                <TextBlock Text="Select a layer above to configure its properties." Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" TextWrapping="Wrap"/>
                            </controls:SectionPanel>

                            <StackPanel Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                                <!-- Capture Source selector (Primary/PiPs) -->
                                <StackPanel Visibility="{Binding IsOverlay, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="Capture Target" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:ScenesView}, Path=ViewModel.SceneEditor.AvailableSources}"
                                              SelectedValue="{Binding SourceId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Margin="0,0,0,8"/>
                                </StackPanel>

                                <!-- Generic Property Sections for Selected Slot -->
                                <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:ScenesView}, Path=ViewModel.SceneEditor.SelectedSlotInspectorSections}" Margin="0,0,0,8"/>

                                <!-- Precision Layout -->
                                <controls:SectionPanel HeaderText="Layout Settings" Margin="0,0,0,8">
                                    <StackPanel>
                                        <CheckBox Content="Lock Aspect Ratio" IsChecked="{Binding IsAspectLocked, Mode=TwoWay}" Margin="0,2,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="4"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="X (%)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Text="{Binding XPercent, StringFormat={}{0:F1}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2">
                                                <TextBlock Text="Y (%)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Text="{Binding YPercent, StringFormat={}{0:F1}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0">
                                                <TextBlock Text="Width (%)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Text="{Binding WPercent, StringFormat={}{0:F1}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2">
                                                <TextBlock Text="Height (%)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Text="{Binding HPercent, StringFormat={}{0:F1}}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Corner rounding -->
                                        <Grid Margin="0,10,0,0" Visibility="{Binding IsBlurOverlay, Converter={StaticResource InverseBoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Corners" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,8,0"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                    Value="{Binding CornerRadiusPercent, Mode=TwoWay}"/>
                                            <TextBlock Grid.Column="2" Width="28" VerticalAlignment="Center" TextAlignment="Right"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                       Text="{Binding CornerRadiusPercent, StringFormat={}{0:F0}}"/>
                                        </Grid>

                                        <!-- Opacity -->
                                        <Grid Margin="0,10,0,0" Visibility="{Binding IsBlurOverlay, Converter={StaticResource InverseBoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Opacity" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,8,0"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                    Value="{Binding OpacityPercent, Mode=TwoWay}"/>
                                            <TextBlock Grid.Column="2" Width="28" VerticalAlignment="Center" TextAlignment="Right"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                       Text="{Binding OpacityPercent, StringFormat={}{0:F0}}"/>
                                        </Grid>

                                        <!-- Rotation -->
                                        <Grid Margin="0,10,0,0" Visibility="{Binding IsBlurOverlay, Converter={StaticResource InverseBoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Rotation" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,8,0"/>
                                            <ComboBox Grid.Column="1" SelectedIndex="{Binding RotationDegrees, Converter={StaticResource RotationDegreesToIndex}}">
                                                <ComboBoxItem Content="0°"/>
                                                <ComboBoxItem Content="90°"/>
                                                <ComboBoxItem Content="180°"/>
                                                <ComboBoxItem Content="270°"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </controls:SectionPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Style="{StaticResource PanelSplitterStyle}"/>

        <!-- Right column: placement canvas — a static aspect-ratio backdrop stands in for the
             live preview (no captured frame is ever bound here), positioning/resizing/snapping
             works identically to Go Live via the same SlotPlacementBehavior. -->
        <Border Grid.Column="2" Padding="0" Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}" BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}"
                BorderThickness="1" CornerRadius="6" MinWidth="400">
            <Viewbox Stretch="Uniform" Margin="8" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Canvas Width="640" Height="{Binding ViewModel.SceneEditor.ActiveScene.CanvasHeight}" Background="Transparent"
                        behaviors:SlotPlacementBehavior.IsEnabled="True"
                        behaviors:SlotPlacementBehavior.SelectedSlot="{Binding ViewModel.SceneEditor.SelectedSlot, Mode=TwoWay}">
                    <!-- Static aspect-ratio backdrop standing in for the live composited output —
                         always fills the whole canvas exactly (it's not any one layer's own view,
                         a primary no longer implies "the whole frame") — no Source binding, just a
                         plain fill sized/positioned the same way the real preview image would be. -->
                    <Border Background="#22FFFFFF" IsHitTestVisible="False" Width="640" Canvas.Left="0" Canvas.Top="0"
                            Height="{Binding ViewModel.SceneEditor.ActiveScene.CanvasHeight}"/>
                    <ItemsControl ItemsSource="{Binding ViewModel.SceneEditor.FlattenedSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="640" Height="{Binding ViewModel.SceneEditor.ActiveScene.CanvasHeight}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding RenderXPercent, Converter={StaticResource PercentToPixel}, ConverterParameter=640}"/>
                                <Setter Property="Canvas.Top">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource PercentToDynamicPixel}">
                                            <Binding Path="RenderYPercent"/>
                                            <Binding Path="CanvasHeight"/>
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SourceSlot}">
                                <Grid Width="{Binding RenderWPercent, Converter={StaticResource PercentToPixel}, ConverterParameter=640}">
                                    <Grid.Height>
                                        <MultiBinding Converter="{StaticResource PercentToDynamicPixel}">
                                            <Binding Path="RenderHPercent"/>
                                            <Binding Path="CanvasHeight"/>
                                        </MultiBinding>
                                    </Grid.Height>
                                    <!-- Content is clipped to the corner radius and faded by Opacity
                                         separately from the drag handles below, so a large radius never
                                         eats the resize handle and a faded layer stays easy to select. -->
                                    <Grid Opacity="{Binding OpacityPercent, Converter={StaticResource PercentToFraction}}"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform Angle="{Binding RotationDegrees}"/>
                                        </Grid.RenderTransform>
                                        <Grid.Clip>
                                            <MultiBinding Converter="{StaticResource CornerClip}">
                                                <Binding Path="RenderWPercent" Converter="{StaticResource PercentToPixel}" ConverterParameter="640"/>
                                                <Binding Path="RenderHPercent"/>
                                                <Binding Path="CanvasHeight"/>
                                                <Binding Path="CornerRadiusPercent"/>
                                            </MultiBinding>
                                        </Grid.Clip>
                                        <!-- Image overlays are static, so they're rendered directly from the
                                             file (client-side) rather than waiting on composited frames. Hidden
                                             in favor of the chroma-keyed preview below while that's enabled. -->
                                        <Image Source="{Binding Content.ImagePath}" Stretch="Fill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsImageOverlay}" Value="True"/>
                                                                <Condition Binding="{Binding Content.ChromaKeyEnabled}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <!-- Locally chroma-keyed render of the same file (see
                                             SceneEditorViewModel.ScheduleChromaKeyPreviewUpdate) — a WYSIWYG
                                             preview of what the real composited/stream output already shows. -->
                                        <Image Source="{Binding Content.KeyedPreviewSource}" Stretch="Fill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsImageOverlay}" Value="True"/>
                                                                <Condition Binding="{Binding Content.ChromaKeyEnabled}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <!-- Unified Text-Based Overlay Renderer (Text, Timer, Sub-Layers, Plugins) -->
                                         <Grid Visibility="{Binding IsTextBasedOverlay, Converter={StaticResource BoolToVisibility}}" ClipToBounds="True">
                                             <TextBlock Text="{Binding TextOverlayDisplayText}"
                                                        FontFamily="{Binding TextOverlayStyle.FontFamily}"
                                                        FontSize="{Binding TextOverlayStyle.FontSize, Converter={StaticResource DoubleScale}, ConverterParameter=0.5}"
                                                        FontWeight="{Binding TextOverlayStyle.IsBold, Converter={StaticResource BoolToFontWeight}}"
                                                        FontStyle="{Binding TextOverlayStyle.IsItalic, Converter={StaticResource BoolToFontStyle}}"
                                                        TextAlignment="{Binding TextOverlayStyle.Alignment, Converter={StaticResource TextAlignmentToWpf}}"
                                                        Foreground="{Binding TextOverlayStyle.FontColor, Converter={StaticResource ColorToBrush}}"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                         </Grid>
                                        <!-- Color overlays are a flat fill — no image/text content to render. -->
                                        <Border Background="{Binding Content.OverlayColor, Converter={StaticResource ColorToBrush}}"
                                                Visibility="{Binding IsColorOverlay, Converter={StaticResource BoolToVisibility}}"/>
                                        <!-- Chat overlays render recent chat messages locally — populated only
                                             if the Go Live page's chat connection is currently active, since
                                             this page has no chat connection of its own. Kept in proportion
                                             with OverlayContentRenderer.RenderChatToBgra's own scaling
                                             (Style.FontSize / 3) via DoubleScale — see GoLiveView.xaml's
                                             identical block for the full rationale. -->
                                        <Border Background="#40000000" ClipToBounds="True" Visibility="{Binding IsChatOverlay, Converter={StaticResource BoolToVisibility}}">
                                            <!-- ElementName, not RelativeSource AncestorType=ItemsControl — see
                                                 GoLiveView.xaml's identical block for why (ambiguous with the
                                                 outer Slots ItemsControl this is nested inside). -->
                                            <!-- DisplayMessages, not ChatMessages directly — see
                                                 GoLiveView.xaml's identical block / ChatOverlayContent.
                                                 DisplayMessages' own doc comment for why. -->
                                            <!-- ScrollViewer + explicit scroll-to-bottom — see GoLiveView.xaml's
                                                 identical block for why (not VerticalAlignment="Bottom"). Style=
                                                 {x:Null} + zeroed Padding/BorderThickness/Margin for the same
                                                 reason too (rules out AdonisUI's themed template as a source of a
                                                 small constant pixel offset). -->
                                            <ScrollViewer Style="{x:Null}" Padding="0" BorderThickness="0" Margin="0"
                                                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                                          IsHitTestVisible="False" ScrollChanged="ChatScrollViewer_ScrollChanged">
                                            <!-- VerticalAlignment="Bottom" — see GoLiveView.xaml's identical
                                                 block for why (safe/reliable in combination with ScrollToEnd(),
                                                 unlike the earlier bare-Border attempt). -->
                                            <ItemsControl x:Name="ChatMessagesItemsControl" ItemsSource="{Binding Content.DisplayMessages}" VerticalAlignment="Bottom">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type services:ChatMessage}">
                                                        <!-- Top-only margin — see GoLiveView.xaml's identical block
                                                             for the full rationale (matches RenderChatToBgra's own
                                                             spacing/inset model exactly). -->
                                                        <TextBlock TextWrapping="Wrap"
                                                                   Margin="{Binding ElementName=ChatMessagesItemsControl, Path=DataContext.Content.Style.FontSize, Converter={StaticResource MessageSpacingMargin}}"
                                                                   FontFamily="{Binding ElementName=ChatMessagesItemsControl, Path=DataContext.Content.Style.FontFamily}"
                                                                   FontSize="{Binding ElementName=ChatMessagesItemsControl, Path=DataContext.Content.Style.FontSize, Converter={StaticResource DoubleScale}, ConverterParameter=0.333333}"
                                                                   FontStyle="{Binding ElementName=ChatMessagesItemsControl, Path=DataContext.Content.Style.IsItalic, Converter={StaticResource BoolToFontStyle}}">
                                                            <Run Text="{Binding Username, StringFormat={}{0}:}" FontWeight="Bold"
                                                                 Foreground="{Binding ColorHex, FallbackValue=Cyan, TargetNullValue=Cyan}"/>
                                                            <Run Text="{Binding Text}"
                                                                 FontWeight="{Binding ElementName=ChatMessagesItemsControl, Path=DataContext.Content.Style.IsBold, Converter={StaticResource BoolToFontWeight}}"
                                                                 Foreground="{Binding ElementName=ChatMessagesItemsControl, Path=DataContext.Content.Style.FontColor, Converter={StaticResource ColorToBrush}}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                    <Thumb x:Name="MoveThumb" behaviors:SlotPlacementBehavior.Mode="Move">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="#01000000">
                                                    <!-- Selection outline: thin dashed rect, shown when hovered or selected. -->
                                                    <Rectangle x:Name="MoveThumbBorder" Stroke="{Binding IsPrimary, Converter={StaticResource SlotRoleBrush}}"
                                                               StrokeThickness="1" StrokeDashArray="4 2" Fill="Transparent"
                                                               Visibility="Collapsed"/>
                                                    <Border x:Name="MoveThumbHeader" Background="{Binding IsPrimary, Converter={StaticResource SlotRoleBrush}}"
                                                            Opacity="0.85" CornerRadius="0,0,4,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            Padding="6,3" Visibility="Collapsed">
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <!-- Hovering shows the outline & header -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="MoveThumbBorder" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="MoveThumbHeader" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelectedOrChildSelected}" Value="True">
                                                        <Setter TargetName="MoveThumbBorder" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="MoveThumbHeader" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                    <!-- 8-Direction Canvas Resize Thumbs -->
                                     <!-- Top-Left Corner -->
                                     <Thumb behaviors:SlotPlacementBehavior.Mode="Resize" behaviors:SlotPlacementBehavior.ResizeDirection="TopLeft"
                                            Width="12" Height="12" Cursor="SizeNWSE" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                         <Thumb.Template>
                                             <ControlTemplate TargetType="Thumb">
                                                 <Rectangle Fill="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}" Stroke="{Binding IsPrimary, Converter={StaticResource SlotRoleBrush}}" StrokeThickness="1"/>
                                             </ControlTemplate>
                                         </Thumb.Template>
                                     </Thumb>

                                     <!-- Top Side -->
                                     <Thumb behaviors:SlotPlacementBehavior.Mode="Resize" behaviors:SlotPlacementBehavior.ResizeDirection="Top"
                                            Height="8" Cursor="SizeNS" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="6,-4,6,0"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                         <Thumb.Template>
                                             <ControlTemplate TargetType="Thumb">
                                                 <Rectangle Fill="Transparent"/>
                                             </ControlTemplate>
                                         </Thumb.Template>
                                     </Thumb>

                                     <!-- Top-Right Corner -->
                                     <Thumb behaviors:SlotPlacementBehavior.Mode="Resize" behaviors:SlotPlacementBehavior.ResizeDirection="TopRight"
                                            Width="12" Height="12" Cursor="SizeNESW" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                         <Thumb.Template>
                                             <ControlTemplate TargetType="Thumb">
                                                 <Rectangle Fill="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}" Stroke="{Binding IsPrimary, Converter={StaticResource SlotRoleBrush}}" StrokeThickness="1"/>
                                             </ControlTemplate>
                                         </Thumb.Template>
                                     </Thumb>

                                     <!-- Right Side -->
                                     <Thumb behaviors:SlotPlacementBehavior.Mode="Resize" behaviors:SlotPlacementBehavior.ResizeDirection="Right"
                                            Width="8" Cursor="SizeWE" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,6,-4,6"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                         <Thumb.Template>
                                             <ControlTemplate TargetType="Thumb">
                                                 <Rectangle Fill="Transparent"/>
                                             </ControlTemplate>
                                         </Thumb.Template>
                                     </Thumb>

                                     <!-- Bottom-Right Corner -->
                                     <Thumb behaviors:SlotPlacementBehavior.Mode="Resize" behaviors:SlotPlacementBehavior.ResizeDirection="BottomRight"
                                            Width="12" Height="12" Cursor="SizeNWSE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                         <Thumb.Template>
                                             <ControlTemplate TargetType="Thumb">
                                                 <Rectangle Fill="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}" Stroke="{Binding IsPrimary, Converter={StaticResource SlotRoleBrush}}" StrokeThickness="1"/>
                                             </ControlTemplate>
                                         </Thumb.Template>
                                     </Thumb>

                                     <!-- Bottom Side -->
                                     <Thumb behaviors:SlotPlacementBehavior.Mode="Resize" behaviors:SlotPlacementBehavior.ResizeDirection="Bottom"
                                            Height="8" Cursor="SizeNS" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="6,0,6,-4"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                         <Thumb.Template>
                                             <ControlTemplate TargetType="Thumb">
                                                 <Rectangle Fill="Transparent"/>
                                             </ControlTemplate>
                                         </Thumb.Template>
                                     </Thumb>

                                     <!-- Bottom-Left Corner -->
                                     <Thumb behaviors:SlotPlacementBehavior.Mode="Resize" behaviors:SlotPlacementBehavior.ResizeDirection="BottomLeft"
                                            Width="12" Height="12" Cursor="SizeNESW" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-6,0,0,-6"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                         <Thumb.Template>
                                             <ControlTemplate TargetType="Thumb">
                                                 <Rectangle Fill="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}" Stroke="{Binding IsPrimary, Converter={StaticResource SlotRoleBrush}}" StrokeThickness="1"/>
                                             </ControlTemplate>
                                         </Thumb.Template>
                                     </Thumb>

                                     <!-- Left Side -->
                                     <Thumb behaviors:SlotPlacementBehavior.Mode="Resize" behaviors:SlotPlacementBehavior.ResizeDirection="Left"
                                            Width="8" Cursor="SizeWE" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="-4,6,0,6"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                         <Thumb.Template>
                                             <ControlTemplate TargetType="Thumb">
                                                 <Rectangle Fill="Transparent"/>
                                             </ControlTemplate>
                                         </Thumb.Template>
                                     </Thumb>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Alignment guides: shown only while a drag/resize is currently
                         snapped to the canvas bounds/center or another item's edges. -->
                    <Line x:Name="VerticalGuide" behaviors:SlotPlacementBehavior.GuideRole="Vertical" Y1="0" Y2="{Binding ViewModel.SceneEditor.ActiveScene.CanvasHeight}" Stroke="{StaticResource AccentBrush}"
                          StrokeThickness="1" StrokeDashArray="4,2" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <Line x:Name="HorizontalGuide" behaviors:SlotPlacementBehavior.GuideRole="Horizontal" X1="0" X2="640" Stroke="{StaticResource AccentBrush}"
                          StrokeThickness="1" StrokeDashArray="4,2" IsHitTestVisible="False" Visibility="Collapsed"/>
                </Canvas>
            </Viewbox>
        </Border>
        </Grid>
    </Grid>
</Page>
