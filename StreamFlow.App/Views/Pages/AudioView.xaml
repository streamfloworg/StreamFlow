<Page x:Class="StreamFlow.App.Views.Pages.AudioView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
      xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:StreamFlow.App.Views.Pages"
      xmlns:controls="clr-namespace:StreamFlow.App.Controls"
      xmlns:converters="clr-namespace:StreamFlow.App.Converter"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:behavior="clr-namespace:StreamFlow.App.Helpers.Behaviors"
      mc:Ignorable="d"
      Title="AudioView"
      d:DesignHeight="700"
      d:DesignWidth="1100"
      d:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      d:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False"
      x:Name="View">

    <Page.CommandBindings>
        <converters:CommandBindingHelper Command="Play" Binding="{Binding PlayAudioItemCommand}"/>
        <converters:CommandBindingHelper Command="Select" Binding="{Binding QueueAudioItemCommand}"/>
        <converters:CommandBindingHelper Command="NextTrack" Binding="{Binding QueueAudioItemNextCommand}"/>
        <converters:CommandBindingHelper Command="Delete" Binding="{Binding RemoveAudioCommand}"/>
        <converters:CommandBindingHelper Command="Properties" Binding="{Binding EditAudioPropertiesCommand}"/>
        <converters:CommandBindingHelper Command="Copy" Binding="{Binding CopyAudioUriCommand}"/>
    </Page.CommandBindings>

    <Page.Resources>
        <converters:VisibilityToBooleanConverter x:Key="VisibilityToBooleanConverter" />
        <converters:NullVisibilityConverter x:Key="NullVisibilityConverter" />
        <converters:ValueConverterGroup x:Key="InvertedBooleanVisibilityConverter">
            <converters:BooleanInvertConverter />
            <converters:BooleanToVisibilityConverter />
        </converters:ValueConverterGroup>
        <converters:AudioStateToIconConverter x:Key="AudioStateToIconConverter" />
        <converters:AudioViewStyleSelector x:Key="AudioViewStyleSelector" />

        <Style x:Key="ToolbarSegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource {x:Static adonisUi:Brushes.AccentBrush}}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SimpleIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource {x:Static adonisUi:Brushes.Layer3BackgroundBrush}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid x:Name="AudioViewGrid" AllowDrop="True" PreviewDrop="ViewPreviewDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>
        <Grid.Resources>
            <Style TargetType="ListView" x:Key="AudioGridView">
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Style.Triggers>
                    <Trigger Property="HasItems" Value="False">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListView">
                                    <Grid VerticalAlignment="Stretch">
                                        <TextBlock Text="Add or Drop audio files here"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>
        <controls:AudioControls HorizontalContentAlignment="Center" x:Name="AudioController" Grid.Column="1" Grid.Row="0" />
        <!-- Used purely as a quick-filter/toolbar strip — none of these TabItems have real
             Content (the actual library list is AudioListView below, a separate sibling), so
             AdonisUI's default TabControl template (which reserves a bordered content-presenter
             area under the header strip regardless) rendered a visibly empty box under the
             tabs. This template keeps just the header strip and drops that area entirely. -->
        <!-- Sleek unified toolbar for filtering, search, view style, and category management.
             Designed to fit the premium visual style of the transport card. -->
        <Border Grid.Row="1" Grid.Column="1" Height="42" Margin="0,10,0,10" MinWidth="820" HorizontalAlignment="Center"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}"
                BorderThickness="1" CornerRadius="8" Padding="12,0" VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Segmented Filters (All, Tracks, SFX) -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="*"/>
                    <!-- Menu categories -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="12"/>
                    <!-- View toggle -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="12"/>
                    <!-- Search box -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter Segmented Control -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="AllFilterBtn" Style="{StaticResource ToolbarSegmentButtonStyle}" Content="All" IsChecked="True" Checked="FilterRadioButton_Checked" Tag="All"/>
                    <RadioButton x:Name="TracksFilterBtn" Style="{StaticResource ToolbarSegmentButtonStyle}" Content="Audio Tracks" Checked="FilterRadioButton_Checked" Tag="AudioTracks"/>
                    <RadioButton x:Name="SfxFilterBtn" Style="{StaticResource ToolbarSegmentButtonStyle}" Content="Sound Effects" Checked="FilterRadioButton_Checked" Tag="SoundEffects"/>
                </StackPanel>

                <!-- Categories & Tags Menu -->
                <Menu Grid.Column="2" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                    <MenuItem x:Name="CategoriesMenuItem" FocusVisualStyle="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CategoriesMenuIconData}" Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Categories" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Header="Categories">
                            <MenuItem x:Name="c3" Header="New" />
                            <MenuItem x:Name="c5" Header="Edit" />
                        </MenuItem>
                        <MenuItem Header="Tags">
                            <MenuItem x:Name="c2" Header="New" />
                            <MenuItem x:Name="c4" Header="Edit" />
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <!-- View Type Toggle (List/Grid) -->
                <Button Grid.Column="4" Width="30" Height="28" Style="{StaticResource SimpleIconButtonStyle}"
                        Command="{Binding SetAudioViewCommand}" ToolTip="Toggle View Style" VerticalAlignment="Center">
                    <Path x:Name="AudioViewTypeTogglePath" Data="{Binding CurrentViewIconData, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" Stretch="Uniform" Width="14" Height="14" Fill="{StaticResource TextPrimaryBrush}"/>
                </Button>

                <!-- Search Box -->
                <Grid Grid.Column="6" Width="200" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Height="28" Padding="24,4,6,4" VerticalContentAlignment="Center" FontSize="12"
                             adonisExtensions:WatermarkExtension.Watermark="Search..."
                             Text="{Binding AppModel.Instance.Settings.FilterOptions.SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"/>
                    <!-- Search Icon -->
                    <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                          Width="12" Height="12" Fill="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" Stretch="Uniform" HorizontalAlignment="Left" IsHitTestVisible="False" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
        <ListView
            x:Name="AudioListView"
            x:FieldModifier="public"
            Grid.Row="2"
            Grid.Column="1"
            Background="Transparent"
            BorderThickness="0"
            VerticalContentAlignment="Top"
            ItemsSource="{Binding AudioListCollectionView}"
            Style="{Binding ViewType, Converter={StaticResource AudioViewStyleSelector}, UpdateSourceTrigger=PropertyChanged, FallbackValue={StaticResource AudioGridView}}"
            IsTextSearchEnabled="True"
            Margin="0,0,0,0"
            HorizontalAlignment="Stretch"
            PreviewKeyDown="AudioListViewPreviewKeyDown"
            HorizontalContentAlignment="Stretch"
            SelectedItem="{Binding SelectedAudio}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.CanContentScroll="True"
            DataContext="{Binding}"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            VirtualizingPanel.ScrollUnit="Pixel"
            Loaded="AudioListView_Loaded">
            <i:Interaction.Behaviors>
                <behavior:ScrollToSelectedListViewItemBehavior />
            </i:Interaction.Behaviors>
            <ListView.ContextMenu>
                <!--
                    ContextMenu DataContext is set directly in AudioListView_Loaded code-behind
                    since XAML PlacementTarget bindings are unreliable for popup visual trees.
                -->
                <ContextMenu>
                    <MenuItem Command="{Binding AddAudioCommand}">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource AddIconData}" Fill="{StaticResource TextPrimaryBrush}" Stretch="Uniform" />
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock Text="Add Audio File"/>
                        </MenuItem.Header>
                    </MenuItem>
                    <!--
                        Use PlayAudioItemCommand (no CanExecute guard) so Play is always enabled.
                        PlayAudioCommand has CanExecute = CanExecutePlayPause (only true when already playing).
                    -->
                    <MenuItem Command="{Binding PlayAudioItemCommand}"
                              CommandParameter="{Binding SelectedAudio}">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource PlayIconData}" Fill="{StaticResource TextPrimaryBrush}" Stretch="Uniform" />
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock Text="Play"/>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="{Binding StopAudioCommand}">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource StopIconData}" Fill="{StaticResource TextPrimaryBrush}" Stretch="Uniform" />
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock Text="Stop"/>
                        </MenuItem.Header>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Command="{Binding EditAudioPropertiesCommand}"
                              CommandParameter="{Binding SelectedAudio}">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource SettingsIconData}" Fill="{StaticResource TextPrimaryBrush}" Stretch="Uniform" />
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock Text="Properties"/>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="RemoveAudioClick"
                              Tag="{Binding SelectedAudio}">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource DeleteIconData}" Fill="{StaticResource TextPrimaryBrush}" Stretch="Uniform" />
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock Text="Remove from list"/>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="{Binding RemoveAudioCommand}"
                              CommandParameter="{Binding SelectedAudio}">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource DeleteForeverIconData}" Fill="{StaticResource TextPrimaryBrush}" Stretch="Uniform" />
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock Text="Delete permanently"/>
                        </MenuItem.Header>
                    </MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>

        <!-- Floating add button — replaces the nav bar's old "Add" item; same AddAudioCommand
             already used by the list's own context menu above. CircleIconButtonStyle only draws
             the ring itself (see its own doc comment), so the "+" glyph is layered on top via a
             Grid rather than as the button's Content, same pattern as AudioControls' play/pause
             button. Two plain Rectangles instead of a premade icon geometry, since the only
             existing "add" icon (AddIconData) already bakes in its own circle outline — stacking
             that inside this button's own ring would look like two overlapping circles. -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="24" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="48" Height="48">
            <Button Style="{StaticResource CircleIconButtonStyle}" Width="48" Height="48"
                    Command="{Binding AddAudioCommand}" ToolTip="Add audio files">
                <Button.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="12" ShadowDepth="3" Direction="270"/>
                </Button.Effect>
            </Button>
            <Rectangle Width="16" Height="2" Fill="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Rectangle Width="2" Height="16" Fill="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Page>
