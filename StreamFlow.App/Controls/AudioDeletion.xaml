<adonisControls:AdonisWindow
    x:Class="StreamFlow.App.Controls.AudioDeletion"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
    mc:Ignorable="d"
    Title="Delete Audio"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False">
    
    <Border Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
            BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="24,20"
            Width="340">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="16" ShadowDepth="0" Direction="270"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header/Icon -->
            <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Stretch="Uniform" Width="48" Height="48" Data="{StaticResource DeleteForeverIconData}"/>
            </Grid>
            
            <!-- Message -->
            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Delete Audio" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="Do you want to delete this audio file?" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding AudioToDelete.Name}" HorizontalAlignment="Center" Margin="0,0,0,12" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Text="Tip: Hold Shift to skip this dialog" HorizontalAlignment="Center" Margin="0,0,0,20" />
            
            <!-- Action Buttons -->
            <UniformGrid Columns="2" HorizontalAlignment="Center" Width="280">
                <Button Content="Cancel" IsCancel="True" Click="CancelButton_Click" Height="30" Margin="0,0,6,0" />
                <Button Content="Delete" IsDefault="True" Click="DeleteButton_Click" Height="30" Margin="6,0,0,0" />
            </UniformGrid>
        </StackPanel>
    </Border>
</adonisControls:AdonisWindow>
