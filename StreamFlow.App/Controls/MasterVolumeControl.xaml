<UserControl
    x:Class="StreamFlow.App.Controls.MasterVolumeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:conv="clr-namespace:StreamFlow.App.Converter"
    xmlns:local="clr-namespace:StreamFlow.App.Controls"
    mc:Ignorable="d"
    d:DesignHeight="220" d:DesignWidth="84"
    Width="84" x:Name="Root">
    <!-- Always-present master stream-mix gain, styled to match AudioChannelStrip's panel/fader/
         meter (same dark navy gradient, grain texture, dimmed-cyan accent, rounded LED bars) but
         simpler — no solo/mute or device-volume row, since "master" isn't tied to any one
         physical device. The fader/meter templates below are a deliberate near-duplicate of
         AudioChannelStrip's rather than a shared resource: the two bind to different kinds of
         thing (a single ViewModel property here vs. a whole AudioSourceItem there), and
         extracting a shared, parameterized template would cost more complexity than the markup
         it'd save. -->
    <UserControl.Resources>
        <conv:PercentToDynamicPixelConverter x:Key="PercentToDynamicPixel"/>
        <local:InverseFractionToPixelConverter x:Key="InverseFractionToPixel"/>
        <local:SizeToRectConverter x:Key="SizeToRect"/>
        <SolidColorBrush x:Key="MasterSlotBrush" Color="#141416"/>

        <!-- Same ramp as AudioChannelStrip's MeterLedBrush — soft green/amber/coral zones. -->
        <LinearGradientBrush x:Key="MasterMeterLedBrush" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#4ADE80" Offset="0"/>
            <GradientStop Color="#4ADE80" Offset="0.70"/>
            <GradientStop Color="#FBBF24" Offset="0.70"/>
            <GradientStop Color="#FBBF24" Offset="0.90"/>
            <GradientStop Color="#F87171" Offset="0.90"/>
            <GradientStop Color="#F87171" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Border CornerRadius="6">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#161D2A" Offset="0"/>
                        <GradientStop Color="#0C1018" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border CornerRadius="6" Opacity="0.35">
                <Border.Background>
                    <ImageBrush ImageSource="/Images/paneltexture_grain.png" TileMode="Tile"
                                Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="Uniform"/>
                </Border.Background>
            </Border>

            <!--<Border CornerRadius="6" Height="40" VerticalAlignment="Top" Margin="1" IsHitTestVisible="False" Opacity="0">
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0" Center="0.5,0" RadiusX="0.9" RadiusY="1.4">
                        <GradientStop Color="#22FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>-->

            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Master" FontWeight="SemiBold" TextAlignment="Center" FontSize="11" Margin="0,0,0,2"/>

                <TextBlock Grid.Row="1" Text="{Binding Value, ElementName=Root, StringFormat={}{0:F0}%}"
                           FontSize="11" TextAlignment="Center" Margin="0,0,0,4"/>

                <Grid Grid.Row="2" x:Name="MeterHost" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Slider Grid.Column="0" Orientation="Vertical" Minimum="0" Maximum="100" HorizontalAlignment="Center"
                        Value="{Binding Value, ElementName=Root, Mode=TwoWay}" Focusable="False" Width="28">
                        <Slider.Template>
                            <ControlTemplate TargetType="Slider">
                                <Grid Width="25">
                                    <Border Width="6" Margin="0,10,0,10" HorizontalAlignment="Center" CornerRadius="2"
                                        Background="{StaticResource MasterSlotBrush}"
                                        BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="1">
                                        <Grid x:Name="SlotInner">
                                            <Rectangle VerticalAlignment="Bottom" Fill="#007880" RadiusX="1" RadiusY="1">
                                                <Rectangle.Height>
                                                    <MultiBinding Converter="{StaticResource PercentToDynamicPixel}">
                                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                                        <Binding ElementName="SlotInner" Path="ActualHeight"/>
                                                    </MultiBinding>
                                                </Rectangle.Height>
                                            </Rectangle>
                                        </Grid>
                                    </Border>
                                    <Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="Slider.DecreaseLarge" Template="{StaticResource TrackEmptyTemplate}" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="Slider.IncreaseLarge" Template="{StaticResource TrackEmptyTemplate}" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Width="24" Height="12" Cursor="SizeNS">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <!-- Track stretches the thumb's own outer bounds to its full cross-axis
                                                         width for a vertical slider, ignoring the Thumb's own declared
                                                         Width — this inner, explicitly-sized Grid gives the cap and grip
                                                         line a shared, guaranteed-centered coordinate space regardless of
                                                         whatever width Track actually arranges the thumb to. -->
                                                        <Grid RenderTransformOrigin="0.5,0.5" Width="24" HorizontalAlignment="Center">
                                                            <Grid.RenderTransform>
                                                                <ScaleTransform x:Name="ThumbScale"/>
                                                            </Grid.RenderTransform>
                                                            <Border CornerRadius="2" BorderThickness="1" BorderBrush="#1E1E20">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#B9B9BE" Offset="0"/>
                                                                        <GradientStop Color="#8E8E93" Offset="0.45"/>
                                                                        <GradientStop Color="#606065" Offset="0.55"/>
                                                                        <GradientStop Color="#7C7C81" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <Border.Effect>
                                                                    <DropShadowEffect x:Name="ThumbGlow" Color="#007880" BlurRadius="12" ShadowDepth="0" Opacity="0"/>
                                                                </Border.Effect>
                                                            </Border>
                                                            <Rectangle Height="2" Margin="4,0" VerticalAlignment="Center" Fill="#007880" RadiusX="1" RadiusY="1"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="ThumbGlow" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.2"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="ThumbGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.12"/>
                                                                            <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.12"/>
                                                                            <DoubleAnimation Storyboard.TargetName="ThumbGlow" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.15"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="ThumbGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Slider.Template>
                    </Slider>

                    <!-- Loudest currently-selected, unmuted channel's own smoothed level (see
                         MasterVolumeControl.xaml.cs) — an approximation of the overall stream
                         mix rather than a true post-mix peak, styled identically to
                         AudioChannelStrip's own meter bars (rounded track via an explicit clip,
                         since Border doesn't auto-clip its child to CornerRadius in WPF). -->
                    <StackPanel Grid.Column="1" x:Name="MasterMeterBars" Orientation="Horizontal" Margin="6,10,0,10">
                        <Border Width="11" Margin="0,0,3,0" CornerRadius="5" Background="{StaticResource MasterSlotBrush}">
                            <Grid x:Name="MasterMeterClip1">
                                <Grid.Clip>
                                    <RectangleGeometry RadiusX="5" RadiusY="5">
                                        <RectangleGeometry.Rect>
                                            <MultiBinding Converter="{StaticResource SizeToRect}">
                                                <Binding ElementName="MasterMeterClip1" Path="ActualWidth"/>
                                                <Binding ElementName="MasterMeterClip1" Path="ActualHeight"/>
                                            </MultiBinding>
                                        </RectangleGeometry.Rect>
                                    </RectangleGeometry>
                                </Grid.Clip>
                                <Rectangle Fill="{StaticResource MasterMeterLedBrush}"/>
                                <Rectangle Fill="{StaticResource MasterSlotBrush}" VerticalAlignment="Top">
                                    <Rectangle.Height>
                                        <MultiBinding Converter="{StaticResource InverseFractionToPixel}">
                                            <Binding ElementName="Root" Path="MeterFillFraction"/>
                                            <Binding ElementName="MasterMeterBars" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Rectangle.Height>
                                </Rectangle>
                            </Grid>
                        </Border>
                        <Border Width="11" CornerRadius="5" Background="{StaticResource MasterSlotBrush}">
                            <Grid x:Name="MasterMeterClip2">
                                <Grid.Clip>
                                    <RectangleGeometry RadiusX="5" RadiusY="5">
                                        <RectangleGeometry.Rect>
                                            <MultiBinding Converter="{StaticResource SizeToRect}">
                                                <Binding ElementName="MasterMeterClip2" Path="ActualWidth"/>
                                                <Binding ElementName="MasterMeterClip2" Path="ActualHeight"/>
                                            </MultiBinding>
                                        </RectangleGeometry.Rect>
                                    </RectangleGeometry>
                                </Grid.Clip>
                                <Rectangle Fill="{StaticResource MasterMeterLedBrush}"/>
                                <Rectangle Fill="{StaticResource MasterSlotBrush}" VerticalAlignment="Top">
                                    <Rectangle.Height>
                                        <MultiBinding Converter="{StaticResource InverseFractionToPixel}">
                                            <Binding ElementName="Root" Path="MeterFillFraction"/>
                                            <Binding ElementName="MasterMeterBars" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Rectangle.Height>
                                </Rectangle>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
