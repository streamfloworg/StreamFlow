<UserControl
    x:Class="StreamFlow.App.Controls.PropertiesEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:helpers="clr-namespace:StreamFlow.App.Helpers"
    xmlns:converters="clr-namespace:StreamFlow.App.Converter"
    xmlns:ah="clr-namespace:StreamFlow.Core.AudioHandling;assembly=StreamFlow.Core"
    xmlns:ap="clr-namespace:StreamFlow.Core.AudioProperties;assembly=StreamFlow.Core"
    mc:Ignorable="d"
    MaxWidth="340"
    MinWidth="320"
    FontSize="12"
    d:DataContext="{d:DesignInstance ah:Audio}"
    DataContext="{Binding Path=Audio, RelativeSource={RelativeSource Mode=Self}}">

    <UserControl.Resources>
        <converters:HotkeyConverter x:Key="HotkeyConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NullVisibilityConverter x:Key="NullVisibilityConverter" />

        <!-- A row's label column shares one width across the whole dialog (via the root
             Grid.IsSharedSizeScope below) so every "Label:" lines up in a single column
             regardless of section, the way a real Properties/Details tab does. -->
        <Style x:Key="PropLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="PropRowGridStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <!-- Section header ("General", "File Metadata") — a plain bold label with a rule
             underneath, matching how Explorer's Details tab separates groups without boxing
             each one in its own card. -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <!-- Icon click/drop affordance -->
        <Style x:Key="SimpleIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource {x:Static adonisUi:Brushes.Layer3BackgroundBrush}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bottom-right dialog button, classic ~75x23 Windows dialog-button proportions -->
        <Style x:Key="DialogFooterButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="75"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource DialogCard}" Padding="14,12" Grid.IsSharedSizeScope="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Icon + name banner -->
                <RowDefinition Height="Auto" />
                <!-- Separator -->
                <RowDefinition Height="Auto" />
                <!-- Scrollable label/value rows -->
                <RowDefinition Height="*" />
                <!-- Separator -->
                <RowDefinition Height="Auto" />
                <!-- Footer button -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Icon + name banner, centered — same layout Explorer's own General tab uses:
                 icon on top, editable name directly beneath it. -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,4,0,10">
                <Border Width="48" Height="48" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer2BorderBrush}}"
                        Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}"
                        HorizontalAlignment="Center" ClipToBounds="True"
                        AllowDrop="True" DragOver="IconBorder_DragOver" Drop="IconBorder_Drop">
                    <Grid>
                        <Image Stretch="UniformToFill" Source="{Binding ImageSource}"/>

                        <Path Data="M19,5V19H5V5H19M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M14.14,11.86L11.14,15.73L9,13.14L6,17H18L14.14,11.86Z"
                              Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.5">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>

                        <Border x:Name="HoverOverlay" Background="#40000000" Opacity="0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button Style="{StaticResource SimpleIconButtonStyle}" Click="ChooseIcon_Click" ToolTip="Choose icon" Padding="2">
                                    <Path Data="M9,3L5,6.99H8V14H10V6.99H13M16,17.01V10H14V17.01H11L15,21L19,17.01H16Z" Width="10" Height="10" Stretch="Uniform" Fill="White"/>
                                </Button>
                                <Button Style="{StaticResource SimpleIconButtonStyle}" Click="ClearIcon_Click" ToolTip="Clear icon" Padding="2" Margin="0,2,0,0"
                                        Visibility="{Binding ImageSource, Converter={StaticResource NullVisibilityConverter}}">
                                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Width="9" Height="9" Stretch="Uniform" Fill="White"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontWeight="SemiBold" FontSize="14" TextAlignment="Center"
                         BorderThickness="0" Background="Transparent" Margin="0,6,0,0" Padding="2"
                         MinWidth="140" MaxWidth="290" HorizontalAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static adonisUi:Brushes.AccentBrush}}"/>
                                    <Setter Property="Background" Value="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>

            <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer2BorderBrush}}" Margin="0,0,0,2"/>

            <!-- Label/value rows (Scrollable) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,4,4,4">

                    <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4"/>

                    <Grid Style="{StaticResource PropRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PropLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Audio Type:" Style="{StaticResource PropLabelStyle}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Source={helpers:EnumBindingSource {x:Type ap:AudioTypes}}}"
                                  SelectedValue="{Binding AudioType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="24" Padding="6,2"/>
                    </Grid>

                    <Grid Style="{StaticResource PropRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PropLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Hotkey:" Style="{StaticResource PropLabelStyle}"/>
                        <TextBox Grid.Column="1"
                            Height="24"
                            Padding="6,2"
                            IsReadOnly="True"
                            IsReadOnlyCaretVisible="False"
                            IsUndoEnabled="False"
                            PreviewKeyDown="HotkeyTextBoxPreviewKeyDown"
                            Text="{Binding Hotkey, Converter={StaticResource HotkeyConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue='Click to set...'}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static adonisUi:Brushes.AccentBrush}}"/>
                                            <Setter Property="Background" Value="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <Grid Style="{StaticResource PropRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PropLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Location:" Style="{StaticResource PropLabelStyle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding FilePath}"/>
                    </Grid>

                    <Grid Style="{StaticResource PropRowGridStyle}" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PropLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tags:" Style="{StaticResource PropLabelStyle}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                        <ListBox Grid.Column="1" ItemsSource="{Binding Tags}" Height="60" BorderThickness="1" Padding="2"
                                 Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}"
                                 BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer2BorderBrush}}"/>
                    </Grid>

                    <!-- File Metadata section — same label/value row shape as General above, sharing
                         its label column width, so the two groups read as one continuous list the
                         way Explorer's own Details tab does rather than a separate boxed panel. -->
                    <StackPanel Visibility="{Binding HasMetadata, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock Text="Format Metadata" Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid Style="{StaticResource PropRowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PropLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Format:" Style="{StaticResource PropLabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Metadata.FormatName}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Style="{StaticResource PropRowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PropLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sample Rate:" Style="{StaticResource PropLabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Metadata.SampleRate, StringFormat='{}{0} Hz'}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Style="{StaticResource PropRowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PropLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Channels:" Style="{StaticResource PropLabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Metadata.ChannelCount}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Style="{StaticResource PropRowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PropLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bit Depth:" Style="{StaticResource PropLabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Metadata.BitsPerSample, TargetNullValue='N/A'}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Style="{StaticResource PropRowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PropLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Duration:" Style="{StaticResource PropLabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Metadata.Duration, StringFormat='{}{0:mm\\:ss}'}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer2BorderBrush}}" Margin="0,2,0,0"/>

            <!-- Footer: all fields are already live TwoWay bindings straight onto the Audio
                 instance (no staged/pending copy), so there's nothing for a Cancel to actually
                 revert — a single OK that just closes the dialog is the honest equivalent here,
                 unlike Explorer's real OK/Cancel/Apply which operate on a pending edit set. -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="PropCloseButton" Content="OK" Style="{StaticResource DialogFooterButtonStyle}" IsDefault="True"/>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
