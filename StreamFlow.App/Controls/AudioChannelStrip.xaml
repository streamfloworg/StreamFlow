                                       FontSize="9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonText" Property="Foreground" Value="#FBBF24"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckedOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="CheckedGlow" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="CheckedGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.90" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.90" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ducking Target Toggle Button Style (Purple Glow) -->
        <Style x:Key="DuckingTargetToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#555558"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressScale"/>
                            </Grid.RenderTransform>
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11"/>
                            <Border x:Name="HoverOverlay" CornerRadius="11" Background="#252528" Opacity="0"/>
                            <Border x:Name="CheckedOverlay" CornerRadius="11" Opacity="0"
                                    Background="#1B0A2E" BorderBrush="#A78BFA" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="CheckedGlow" Color="#A78BFA" BlurRadius="5" ShadowDepth="0" Opacity="0"/>
                                </Border.Effect>
                            </Border>
                            <TextBlock x:Name="ButtonText"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontWeight="Bold"
                                       FontSize="9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonText" Property="Foreground" Value="#A78BFA"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckedOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="CheckedGlow" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="CheckedGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.90" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.90" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Horizontal Slider Style for Device Volume -->
        <Style x:Key="DeviceVolumeSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="14">
                            <!-- Track Slot background and fill -->
                            <Border Height="4" Margin="6,0,6,0" VerticalAlignment="Center" CornerRadius="2"
                                    Background="{StaticResource MeterSlotBrush}"
                                    BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="1">
                                <Grid x:Name="SlotInner">
                                    <Rectangle HorizontalAlignment="Left" Fill="#007880" RadiusX="1" RadiusY="1">
                                        <Rectangle.Width>
                                            <MultiBinding Converter="{StaticResource PercentToDynamicPixel}">
                                                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                                <Binding ElementName="SlotInner" Path="ActualWidth"/>
                                            </MultiBinding>
                                        </Rectangle.Width>
                                    </Rectangle>
                                </Grid>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Template="{StaticResource TrackEmptyTemplate}" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Template="{StaticResource TrackEmptyTemplate}" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10" Cursor="SizeWE">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="#B9B9BE" Stroke="#1E1E20" StrokeThickness="1"/>
                                                    <Ellipse Fill="#2A2A2E" Width="2" Height="2"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <!-- Base panel gradient — subtle vertical depth instead of a flat fill. Colors match
                 the website's own dark gradient variable (see style.css in the StreamFlow
                 Github.io Page vault), so the app's panels and the site's use the same navy-blue
                 rather than a disconnected neutral gray — same "Neon Pro Audio" accent palette as
                 the toggle buttons below (cyan/magenta/purple) also traces back to that
                 stylesheet. -->
            <Border CornerRadius="6">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#161D2A" Offset="0"/>
                        <GradientStop Color="#0C1018" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Shared grain texture — alpha-encoded over black (see Images/paneltexture_grain.png;
                 generated from the original white+noise Images/paneltexture.png) so plain Normal
                 alpha blending reproduces a multiply-like look: pure white areas in the source
                 became fully transparent here and leave the gradient below untouched, darker
                 noise specks became partially opaque and subtly darken the surface. Same brush
                 on every channel strip regardless of accent color, so they all read as one
                 material. -->
            <Border CornerRadius="6" Opacity="0.35">
                <Border.Background>
                    <ImageBrush ImageSource="/Images/paneltexture_grain.png" TileMode="Tile"
                                Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="Uniform"/>
                </Border.Background>
            </Border>

            <!-- Soft top highlight, like light grazing the panel — most of the "glassy" read
                 from the reference image comes from a single low-opacity radial gradient like
                 this rather than anything more elaborate. -->
            <!--<Border CornerRadius="6" Height="40" VerticalAlignment="Top" Margin="1" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0" Center="0.5,0" RadiusX="0.9" RadiusY="1.4">
                        <GradientStop Color="#22FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>-->

        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Renamable label: defaults to the device's own OS name (bound as DisplayName's
                 initial value in AudioSourceItem), editable in place, persisted per-device-id.
                 Right-click to reset back to the default rather than a dedicated button, which
                 wouldn't fit this control's 108px width alongside the fader/meter below. -->
            <Grid Grid.Row="0" Margin="0,0,0,2">
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}"
                         TextAlignment="Center" FontSize="11" Padding="16,0,16,0"
                         Background="Transparent" BorderThickness="0"
                         ToolTip="{Binding Device.Name, StringFormat=Device: {0}}">
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Reset to default name" Command="{Binding ResetDisplayNameCommand}"
                                      IsEnabled="{Binding IsRenamed}"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" Width="16" Height="16"
                        x:Name="RemoveDeviceHoverButton" Cursor="Hand"
                        Command="{Binding RemoveCommand}" ToolTip="Remove Audio Device">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsMouseOver}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Path Data="M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M8,9H16V19H8V9M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z"
                                      Fill="#EF4444" Stretch="Uniform" Width="10" Height="10"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,4">
                <TextBlock Text="{Binding VolumePercent, StringFormat={}{0:F0}%}" FontSize="11" TextAlignment="Center"/>
                <TextBlock Text="{Binding DisplayDb, StringFormat={}{0:F1} dB}" FontSize="10" TextAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Mixer-style row: fader | numbered scale | segmented LED meter. All three share
                 the same 8px vertical margin so the scale and meter align with the fader cap's
                 actual travel range rather than the row's full height. -->
            <Grid Grid.Row="2" x:Name="MeterHost" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Slider Grid.Column="0" Orientation="Vertical" Minimum="0" Maximum="100"
                        Value="{Binding VolumePercent, Mode=TwoWay}"
                        Style="{StaticResource ChannelFaderStyle}"/>

                <UniformGrid Grid.Column="1" Rows="15" Columns="1" Margin="4,10,4,10">
                    <TextBlock Text="1" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="2" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="3" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="4" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="5" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="6" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="7" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="8" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="9" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="10" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="11" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="12" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="13" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="14" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="15" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                </UniformGrid>

                <!-- Segmented LED level meter (dual bar, both driven by the same mono peak):
                     a full-height fixed green/amber gradient carved into segments by the tiled
                     gap brush, revealed from the bottom by shrinking a slot-colored top cover —
                     eased via AudioSourceItem.SmoothedMeterFillFraction (ticked once per
                     rendered frame — see AudioChannelStrip.xaml.cs) rather than the raw
                     MeterFillFraction, so it doesn't visibly step at the ~33Hz rate new peak
                     data actually arrives at. -->
                <StackPanel Grid.Column="2" x:Name="MeterBars" Orientation="Horizontal" Margin="0,10,0,10">
                    <!-- Track (Border, CornerRadius=5) draws the rounded holder. WPF's Border does
                         NOT auto-clip its child to CornerRadius (that's WinUI/UWP behavior, not
                         classic WPF), so the inner Grid gets its own explicit RectangleGeometry
                         clip sized to match — that's what actually keeps the LED fill/cover's
                         plain flat edges from poking out past the rounded track at 0%/100%. The
                         fill's moving top edge stays a flat straight line either way (it's not at
                         a corner), only the four track corners get rounded off. -->
                    <Border Width="11" Margin="0,0,3,0" CornerRadius="5" Background="{StaticResource MeterSlotBrush}">
                        <Grid x:Name="MeterFillClip1">
                            <Grid.Clip>
                                <RectangleGeometry RadiusX="5" RadiusY="5">
                                    <RectangleGeometry.Rect>
                                        <MultiBinding Converter="{StaticResource SizeToRect}">
                                            <Binding ElementName="MeterFillClip1" Path="ActualWidth"/>
                                            <Binding ElementName="MeterFillClip1" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </RectangleGeometry.Rect>
                                </RectangleGeometry>
                            </Grid.Clip>
                            <Rectangle Fill="{StaticResource MeterLedBrush}"/>
                            <Rectangle Fill="{StaticResource MeterSlotBrush}" VerticalAlignment="Top">
                                <Rectangle.Height>
                                    <MultiBinding Converter="{StaticResource InverseFractionToPixel}">
                                        <Binding Path="SmoothedMeterFillFraction"/>
                                        <Binding ElementName="MeterBars" Path="ActualHeight"/>
                                    </MultiBinding>
                                </Rectangle.Height>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <Border Width="11" CornerRadius="5" Background="{StaticResource MeterSlotBrush}">
                        <Grid x:Name="MeterFillClip2">
                            <Grid.Clip>
                                <RectangleGeometry RadiusX="5" RadiusY="5">
                                    <RectangleGeometry.Rect>
                                        <MultiBinding Converter="{StaticResource SizeToRect}">
                                            <Binding ElementName="MeterFillClip2" Path="ActualWidth"/>
                                            <Binding ElementName="MeterFillClip2" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </RectangleGeometry.Rect>
                                </RectangleGeometry>
                            </Grid.Clip>
                            <Rectangle Fill="{StaticResource MeterLedBrush}"/>
                            <Rectangle Fill="{StaticResource MeterSlotBrush}" VerticalAlignment="Top">
                                <Rectangle.Height>
                                    <MultiBinding Converter="{StaticResource InverseFractionToPixel}">
                                        <Binding Path="SmoothedMeterFillFraction"/>
                                        <Binding ElementName="MeterBars" Path="ActualHeight"/>
                                    </MultiBinding>
                                </Rectangle.Height>
                            </Rectangle>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <ToggleButton Content="S" Width="22" Height="22" Margin="0,0,4,0"
                               Style="{StaticResource SoloToggleStyle}"
                               ToolTip="Solo (stream mix only)" IsChecked="{Binding IsSolo, Mode=TwoWay}"/>
                <ToggleButton Content="M" Width="22" Height="22" Margin="0,0,4,0"
                               Style="{StaticResource MuteToggleStyle}"
                               ToolTip="Mute (stream mix only)" IsChecked="{Binding IsMuted, Mode=TwoWay}"/>
                <ToggleButton Content="T" Width="22" Height="22" Margin="0,0,4,0"
                               Style="{StaticResource DuckingTriggerToggleStyle}"
                               ToolTip="Set as side-chain ducking trigger" IsChecked="{Binding IsDuckingTrigger, Mode=TwoWay}"/>
                <ToggleButton Content="D" Width="22" Height="22"
                               Style="{StaticResource DuckingTargetToggleStyle}"
                               ToolTip="Duck this channel when trigger is active" IsChecked="{Binding IsDuckingTarget, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Device volume: the actual Windows/Volume-Mixer level for this device, distinct
                 from the fader above (which only scales this device's contribution to this
                 app's own stream mix). -->
            <StackPanel Grid.Row="4" Margin="0,8,0,0">
                <TextBlock Text="Device Volume" FontSize="9" TextAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,4,0"
                            Style="{StaticResource DeviceVolumeSliderStyle}"
                            AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0"
                            Value="{Binding DeviceVolumePercent, Mode=TwoWay}"
                            ToolTip="{Binding DeviceVolumePercent, StringFormat={}{0:F0}%}"/>
                    <ToggleButton Grid.Column="1" Content="M" Width="22" Height="22"
                                  Style="{StaticResource DeviceMuteToggleStyle}"
                                  ToolTip="Mute device (Windows volume, affects everyone using it)"
                                  IsChecked="{Binding IsDeviceMuted, Mode=TwoWay}"/>
                </Grid>
            </StackPanel>
        </Grid>
        </Grid>
    </Border>
</UserControl>
