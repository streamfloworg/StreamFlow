<UserControl
    x:Class="StreamFlow.App.Controls.AudioChannelStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:conv="clr-namespace:StreamFlow.App.Converter"
    xmlns:local="clr-namespace:StreamFlow.App.Controls"
    mc:Ignorable="d"
    d:DesignHeight="220" d:DesignWidth="115"
    Width="115">
    <UserControl.Resources>
        <local:FractionToPixelConverter x:Key="FractionToPixel"/>
        <local:InverseFractionToPixelConverter x:Key="InverseFractionToPixel"/>
        <local:SizeToRectConverter x:Key="SizeToRect"/>
        <conv:PercentToDynamicPixelConverter x:Key="PercentToDynamicPixel"/>

        <!-- The dark slot behind both the fader groove and the LED meter bars. -->
        <SolidColorBrush x:Key="MeterSlotBrush" Color="#141416"/>

        <!-- Full-height color ramp with hard zone stops: soft green for the lower ~70% of the
             scale, amber above, coral at the very top — desaturated versions of the classic
             green/amber/red VU zones so the meter reads as semi-bright rather than harsh neon
             LEDs. Paired with the top-cover reveal (see InverseFractionToPixelConverter in
             AudioChannelStrip.xaml.cs) so the amber/coral zones only light when the level
             actually reaches them, instead of stretching with the fill. StartPoint 0,1 = offsets
             run bottom-up. -->
        <LinearGradientBrush x:Key="MeterLedBrush" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#4ADE80" Offset="0"/>
            <GradientStop Color="#4ADE80" Offset="0.70"/>
            <GradientStop Color="#FBBF24" Offset="0.70"/>
            <GradientStop Color="#FBBF24" Offset="0.90"/>
            <GradientStop Color="#F87171" Offset="0.90"/>
            <GradientStop Color="#F87171" Offset="1"/>
        </LinearGradientBrush>

        <!-- Vertical fader styled like a hardware mixer: a thin dark slot with a chunky
             gray gradient cap (dark center grip line) riding it — see AudioChannelStrip.xaml.cs
             for why this needed a full custom template rather than just retemplating the thumb:
             the default track has no "leave the rest of the width transparent" concept. -->
        <Style x:Key="ChannelFaderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Width="24">
                            <!-- Slot the cap rides along. Vertical margins keep the cap's center
                                 reachable at both extremes (half the cap's 20px height). The
                                 bottom-anchored fill inside is the at-a-glance level indicator —
                                 same green as the LED meter's base zone so the strip reads as
                                 one instrument. Sized against SlotInner (the slot's content
                                 area, borders already excluded) so 100% never overflows. -->
                            <Border Width="6" Margin="0,10,0,10" HorizontalAlignment="Center" CornerRadius="2"
                                    Background="{StaticResource MeterSlotBrush}"
                                    BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="1">
                                <Grid x:Name="SlotInner">
                                    <Rectangle VerticalAlignment="Bottom" Fill="#007880" RadiusX="1" RadiusY="1">
                                        <Rectangle.Height>
                                            <MultiBinding Converter="{StaticResource PercentToDynamicPixel}">
                                                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                                <Binding ElementName="SlotInner" Path="ActualHeight"/>
                                            </MultiBinding>
                                        </Rectangle.Height>
                                    </Rectangle>
                                </Grid>
                            </Border>
                            <Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}">
                                <!-- TrackEmptyTemplate (Theme/Controls.xaml) is a bare transparent
                                     border with no triggers, so these click regions get no
                                     hover/pressed chrome — the default RepeatButton template
                                     lights up the whole half-track on mouse-over otherwise. -->
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Template="{StaticResource TrackEmptyTemplate}" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Template="{StaticResource TrackEmptyTemplate}" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <!-- Glow fades in on hover and intensifies while dragging (IsDragging,
                                         a genuine Thumb property — not a synthetic IsPressed check); the
                                         scale bounce on release uses BackEase for a slight overshoot
                                         instead of stopping dead, echoing the toggle buttons' feel. -->
                                    <Thumb Width="24" Height="12" Cursor="SizeNS">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <!-- Track stretches the thumb's own outer bounds to its full cross-axis
                                                     width for a vertical slider, ignoring the Thumb's own declared
                                                     Width — this inner, explicitly-sized Grid gives the cap and grip
                                                     line a shared, guaranteed-centered coordinate space regardless of
                                                     whatever width Track actually arranges the thumb to. -->
                                                <Grid RenderTransformOrigin="0.5,0.5" Width="24" HorizontalAlignment="Center">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform x:Name="ThumbScale"/>
                                                    </Grid.RenderTransform>
                                                    <Border CornerRadius="2" BorderThickness="1" BorderBrush="#1E1E20">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#B9B9BE" Offset="0"/>
                                                                <GradientStop Color="#8E8E93" Offset="0.45"/>
                                                                <GradientStop Color="#606065" Offset="0.55"/>
                                                                <GradientStop Color="#7C7C81" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Effect>
                                                            <DropShadowEffect x:Name="ThumbGlow" Color="#007880" BlurRadius="12" ShadowDepth="0" Opacity="0"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <!-- Center grip line, the classic fader-cap position marker. -->
                                                    <Rectangle Height="2" Margin="4,0" VerticalAlignment="Center" Fill="#007880" RadiusX="1" RadiusY="1"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbGlow" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.12"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.12"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbGlow" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2">
                                                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2">
                                                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Solo Toggle Button Style (Cyan Glow) — off/on/hover states are separate overlay
             layers cross-faded via Opacity rather than instant property Setters, since
             animating a TemplateBinding'd property directly doesn't work reliably in WPF. The
             press-scale bounce uses BackEase so it settles with a slight overshoot instead of
             stopping dead, which is most of what reads as "soft" instead of "rigid". -->
        <Style x:Key="SoloToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#555558"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressScale"/>
                            </Grid.RenderTransform>
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14"/>
                            <Border x:Name="HoverOverlay" CornerRadius="14" Background="#252528" Opacity="0"/>
                            <Border x:Name="CheckedOverlay" CornerRadius="14" Opacity="0"
                                    Background="#0D222B" BorderBrush="#007880" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="CheckedGlow" Color="#007880" BlurRadius="6" ShadowDepth="0" Opacity="0"/>
                                </Border.Effect>
                            </Border>
                            <TextBlock x:Name="ButtonText"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontWeight="Bold"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonText" Property="Foreground" Value="#007880"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckedOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="CheckedGlow" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="CheckedGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.90" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.90" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mute Toggle Button Style (Pink Glow) — same cross-fade/press-bounce treatment as
