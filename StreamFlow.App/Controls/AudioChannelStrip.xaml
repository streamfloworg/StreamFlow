                                    Background="#1C0D26" BorderBrush="#9D4EDD" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="CheckedGlow" Color="#9D4EDD" BlurRadius="5" ShadowDepth="0" Opacity="0"/>
                                </Border.Effect>
                            </Border>
