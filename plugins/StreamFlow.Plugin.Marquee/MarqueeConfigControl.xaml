<UserControl x:Class="StreamFlow.Plugin.Marquee.MarqueeConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="12">
    <StackPanel Width="320">
        <TextBlock Text="Marquee Banner Settings" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

        <TextBlock Text="Banner Text:" FontSize="12" Margin="0,0,0,4"/>
        <TextBox Text="{Binding MarqueeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="4"/>

        <TextBlock Text="Background Color (Hex):" FontSize="12" Margin="0,0,0,4"/>
        <TextBox Text="{Binding BackgroundColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="4"/>

        <TextBlock Text="Text Color (Hex):" FontSize="12" Margin="0,0,0,4"/>
        <TextBox Text="{Binding TextColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="4"/>

        <TextBlock Text="Font Size:" FontSize="12" Margin="0,0,0,4"/>
        <TextBox Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
    </StackPanel>
</UserControl>
